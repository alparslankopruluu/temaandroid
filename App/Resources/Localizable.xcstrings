    "onboarding.video.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir klibin en iyi 3 saniyesini seç, Live Photo olarak kaydet. İlk 2 video ücretsiz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de beste 3 seconden van een clip en bewaar ze als Live Photo. Je eerste 2 zijn gratis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "好きなクリップのベストな3秒を選んでLive Photoとして保存。最初の2本は無料です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die besten 3 Sekunden eines Clips und sichere sie als Live Photo. Deine ersten 2 sind kostenlos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите лучшие 3 секунды любого ролика и сохраните как Live Photo. Первые 2 — бесплатно."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz najlepsze 3 sekundy dowolnego klipu i zapisz jako Live Photo. Pierwsze 2 są za darmo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the best 3 seconds of any clip and save it as a Live Photo. Your first 2 are free."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli i 3 secondi migliori di una clip e salvali come Live Photo. Le prime 2 sono gratis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从任意视频中挑出最精彩的 3 秒，存为实况照片。前 2 个免费。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis les 3 meilleures secondes d’un clip et enregistre-les en Live Photo. Les 2 premières sont gratuites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी क्लिप के सबसे अच्छे 3 सेकंड चुनें और Live Photo के रूप में सेव करें। पहले 2 मुफ़्त हैं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os melhores 3 segundos de qualquer clipe e salve como Live Photo. Os 2 primeiros são grátis."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무 클립에서 가장 좋은 3초를 골라 Live Photo로 저장하세요. 처음 2개는 무료입니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn 3 giây đẹp nhất của bất kỳ clip nào và lưu thành Live Photo. 2 video đầu tiên miễn phí."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih 3 detik terbaik dari klip apa pun dan simpan sebagai Live Photo. 2 pertama gratis."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg de bedste 3 sekunder af et klip, og gem dem som Live Photo. Dine første 2 er gratis."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือก 3 วินาทีที่ดีที่สุดจากคลิปใดก็ได้แล้วบันทึกเป็น Live Photo 2 รายการแรกฟรี"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj de bästa 3 sekunderna av ett klipp och spara dem som Live Photo. Dina första 2 är gratis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige los mejores 3 segundos de cualquier clip y guárdalos como Live Photo. Los 2 primeros son gratis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر أفضل 3 ثوانٍ من أي مقطع واحفظها بصيغة Live Photo. أول مقطعين مجانًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從任何影片中挑出最精彩的 3 秒，儲存為原況照片。前 2 個免費。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg de beste 3 sekundene av et klipp og lagre dem som Live Photo. De 2 første er gratis."
          }
        }
      }
    },
    "onboarding.interests.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekranında ne olsun?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat moet je scherm laten zien?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面に何を映しますか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was soll dein Bildschirm zeigen?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что будет на вашем экране?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co ma pokazywać Twój ekran?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should your screen show?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi sul tuo schermo?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想让屏幕呈现什么？"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que doit montrer ton écran ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी स्क्रीन पर क्या दिखे?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que sua tela deve mostrar?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면에 무엇을 띄울까요?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn muốn màn hình hiển thị gì?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingin layar Anda menampilkan apa?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad skal din skærm vise?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อยากให้หน้าจอแสดงอะไร"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad ska din skärm visa?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres ver en tu pantalla?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن تعرض شاشتك؟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想讓螢幕呈現什麼？"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva skal skjermen vise?"
          }
        }
      }
    },
    "onboarding.interests.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç tane seç, önce onları gösterelim."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies er een paar. We laten ze als eerste zien."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いくつか選んでください。最初に表示します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein paar aus. Wir zeigen sie zuerst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите несколько — покажем их первыми."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kilka. Pokażemy je jako pierwsze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a few. We’ll show them first."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline alcuni. Te li mostreremo per primi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选几个，我们会优先展示。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en quelques-uns. On te les montrera en premier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ चुनें। हम उन्हें पहले दिखाएंगे।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha alguns. Vamos mostrá-los primeiro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 가지 고르세요. 먼저 보여 드릴게요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn vài mục. Chúng tôi sẽ hiển thị chúng trước."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih beberapa. Kami akan menampilkannya lebih dulu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et par stykker. Vi viser dem først."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสักสองสามอย่าง เราจะแสดงให้ก่อน"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj några. Vi visar dem först."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige algunos. Te los mostraremos primero."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر بعضها وسنعرضها أولًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選幾個，我們會優先展示。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg noen. Vi viser dem først."
          }
        }
      }
    },
