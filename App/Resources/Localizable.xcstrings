            "value": "Tous les mondes sont à vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दुनिया। आपकी अपनी।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os mundos. Seus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세계를 내 것으로."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thế giới. Của riêng bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap dunia. Milikmu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verdener. Dine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกโลก เป็นของคุณ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje värld. Din."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los mundos. Tuyos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل العوالم لك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個世界，都屬於你。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle verdener. Dine."
          }
        }
      }
    },
    "pro.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunu kendine özgü kılmanın daha fazla yolu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meer manieren om je telefoon eigen te maken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマホをもっと自分らしくする方法。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Möglichkeiten, dein Handy zu deinem zu machen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Больше способов сделать телефон своим."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Więcej sposobów, by telefon wyrażał Ciebie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More ways to make your phone feel like you."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più modi per rendere il telefono davvero tuo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更多方式，让手机更有你的风格。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Encore plus de façons de personnaliser votre téléphone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ोन को अपना अंदाज़ देने के और तरीके।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais formas de deixar o celular com a sua cara."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰을 더 나답게 만드는 다양한 방법."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm nhiều cách để điện thoại thể hiện chính bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebih banyak cara menampilkan dirimu di ponsel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere måder at gøre telefonen personlig på."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลากหลายวิธีให้โทรศัพท์เป็นตัวคุณยิ่งขึ้น"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fler sätt att göra telefonen till din."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más formas de darle tu toque al teléfono."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طرق أكثر ليعبّر هاتفك عنك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更多方式，讓手機展現你的風格。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Flere måter å gjøre telefonen personlig på."
          }
        }
      }
    },
