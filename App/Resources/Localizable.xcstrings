    "spatial.step.3": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Köşedeki Uzamsal Sahne düğmesine dokun. iOS görsele derinlik ekler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de knop Ruimtelijke scène in de hoek. iOS voegt diepte toe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "隅にある空間シーンボタンをタップ。iOSが画像に奥行きを加えます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe in der Ecke auf „Räumliche Szene“. iOS verleiht dem Bild Tiefe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь кнопки «Пространственная сцена» в углу. iOS добавит глубину."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij przycisk Scena przestrzenna w rogu. iOS doda głębię."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the Spatial Scene button in the corner. iOS adds depth to the image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca il pulsante Scena spaziale nell’angolo. iOS aggiunge profondità."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点角落的“空间场景”按钮，iOS 会为图片添加景深。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le bouton Scène spatiale dans le coin. iOS ajoute de la profondeur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोने में Spatial Scene बटन टैप करें। iOS चित्र में गहराई जोड़ता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no botão Cena Espacial no canto. O iOS adiciona profundidade à imagem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모서리의 공간 장면 버튼을 탭하세요. iOS가 깊이를 더합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm nút Cảnh không gian ở góc. iOS thêm chiều sâu cho ảnh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk tombol Adegan Spasial di sudut. iOS menambahkan kedalaman."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på knappen Rumlig scene i hjørnet. iOS tilføjer dybde."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะปุ่มฉากเชิงพื้นที่ที่มุม iOS จะเพิ่มความลึกให้ภาพ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på knappen Rumslig scen i hörnet. iOS lägger till djup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el botón Escena espacial en la esquina. iOS añade profundidad a la imagen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط زر المشهد المكاني في الزاوية. يضيف iOS عمقاً للصورة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下角落的「空間場景」按鈕，iOS 會為圖片加入景深。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på knappen Romlig scene i hjørnet. iOS legger til dybde."
          }
        }
      }
    },
    "spatial.step.4": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
