            "state": "translated",
            "value": "Buka Pintasan, ketuk Otomatisasi, lalu ketuk +."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Genveje, tryk på Automatisering, og tryk derefter på +."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดคำสั่งลัด แตะระบบอัตโนมัติ แล้วแตะ +"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Genvägar, tryck på Automatisering och sedan på +."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Atajos, toca Automatización y luego +."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الاختصارات، واضغط على الأتمتة، ثم اضغط على +."
