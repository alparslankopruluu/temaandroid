    "spatial.step.2": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar › Duvar Kâğıdı › Yeni Duvar Kâğıdı Ekle'yi aç, Fotoğraflar'ı seç ve görseli belirle."
          }
        },
        "nl": {
          "stringUnit": {
