    "welcome.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilit ekranın için sinematik döngüler ve canlı dünyalar. Dokun, eğ, kendine göre ayarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmische loops en levende werelden voor je toegangsscherm. Raak ze aan, kantel ze, maak ze van jou."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面のためのシネマティックなループと生きている世界。触れて、傾けて、自分らしく。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinoreife Loops und lebendige Welten für deinen Sperrbildschirm. Berühren, neigen, zu deinen machen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кинематографичные петли и живые миры для экрана блокировки. Касайтесь, наклоняйте, делайте своими."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmowe pętle i żywe światy na ekran blokady. Dotykaj, przechylaj, zrób je po swojemu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cinematic loops and living worlds for your Lock Screen. Touch them, tilt them, make them yours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop cinematografici e mondi vivi per la tua schermata di blocco. Toccali, inclinali, rendili tuoi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为锁定屏幕打造的电影感循环与鲜活世界。轻触、倾斜，打造属于你的样子。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des boucles cinématiques et des mondes vivants pour ton écran verrouillé. Touche-les, incline-les, fais-les tiens."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लॉक स्क्रीन के लिए सिनेमैटिक लूप और जीवंत दुनिया। छुएं, झुकाएं, अपना बनाएं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Loops cinematográficos e mundos vivos para a sua Tela Bloqueada. Toque, incline, deixe do seu jeito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 화면을 위한 시네마틱 루프와 살아 있는 세계. 만지고, 기울이고, 나만의 것으로."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vòng lặp điện ảnh và thế giới sống động cho Màn hình khóa. Chạm, nghiêng, biến chúng thành của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop sinematik dan dunia hidup untuk Layar Kunci Anda. Sentuh, miringkan, jadikan milik Anda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmiske loops og levende verdener til din låseskærm. Rør ved dem, vip dem, gør dem til dine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลูปภาพยนตร์และโลกที่มีชีวิตสำหรับหน้าจอล็อก แตะ เอียง และทำให้เป็นของคุณ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmiska loopar och levande världar för låsskärmen. Rör vid dem, luta dem, gör dem till dina."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bucles cinematográficos y mundos vivos para tu pantalla de bloqueo. Tócalos, inclínalos, hazlos tuyos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلقات سينمائية وعوالم نابضة بالحياة لشاشة القفل. المسها، أمِل هاتفك، واجعلها لك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為鎖定畫面打造的電影感循環與鮮活世界。輕觸、傾斜，打造屬於你的樣子。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Filmatiske looper og levende verdener til låseskjermen. Ta på dem, vipp dem, gjør dem til dine."
          }
        }
      }
    },
