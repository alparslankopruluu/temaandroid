    "privacy.local": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasarımların ve favorilerin bu cihazda kalır. Bu sürümde hesap, takip SDK’sı veya buluta yükleme kullanılmaz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je ontwerpen en favorieten blijven op dit apparaat. Deze versie gebruikt geen account, tracking-SDK of cloudupload."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインとお気に入りは、このデバイスに保存されます。この版ではアカウント、トラッキングSDK、クラウドへのアップロードは使用しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Entwürfe und Favoriten bleiben auf diesem Gerät. Diese Version verwendet kein Konto, kein Tracking-SDK und keine Cloud-Uploads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши дизайны и избранное остаются на этом устройстве. В этой сборке нет аккаунтов, SDK отслеживания и загрузки в облако."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekty i ulubione pozostają na tym urządzeniu. Ta wersja nie korzysta z konta, śledzącego SDK ani przesyłania do chmury."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your designs and favorites stay on this device. No account, tracking SDK or cloud upload is used in this build."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi design e preferiti restano su questo dispositivo. Questa versione non usa account, SDK di tracciamento o caricamenti sul cloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的设计与收藏仅保留在此设备上。此版本不使用账号、跟踪SDK或云端上传。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos designs et favoris restent sur cet appareil. Cette version n’utilise ni compte, ni SDK de suivi, ni envoi dans le cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिज़ाइन और पसंदीदा इस डिवाइस पर रहते हैं। इस संस्करण में खाता, ट्रैकिंग SDK या क्लाउड अपलोड नहीं है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus designs e favoritos ficam neste dispositivo. Esta versão não usa conta, SDK de rastreamento nem envio para a nuvem."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디자인과 즐겨찾기는 이 기기에만 저장됩니다. 이 버전은 계정, 추적 SDK 또는 클라우드 업로드를 사용하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết kế và mục yêu thích được lưu trên thiết bị này. Bản này không dùng tài khoản, SDK theo dõi hoặc tải lên đám mây."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Desain dan favoritmu tetap di perangkat ini. Versi ini tidak memakai akun, SDK pelacakan, atau unggahan cloud."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine designs og favoritter bliver på denne enhed. Denne version bruger ingen konto, tracking-SDK eller cloudupload."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดีไซน์และรายการโปรดอยู่ในอุปกรณ์นี้ รุ่นนี้ไม่ใช้บัญชี SDK ติดตาม หรือการอัปโหลดบนคลาวด์"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina designer och favoriter stannar på den här enheten. Den här versionen använder inget konto, spårnings-SDK eller molnuppladdning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus diseños y favoritos se quedan en este dispositivo. Esta versión no usa cuentas, SDK de seguimiento ni subidas a la nube."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى تصاميمك ومفضلاتك على هذا الجهاز. لا تستخدم هذه النسخة حسابًا أو حزمة تتبّع أو رفعًا إلى السحابة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的設計與喜好項目保留於此裝置。本版本不使用帳號、追蹤 SDK 或雲端上傳。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Designene og favorittene dine blir på denne enheten. Denne versjonen bruker ingen konto, sporings-SDK eller skyopplasting."
          }
        }
      }
    },
