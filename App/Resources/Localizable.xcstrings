        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь «Добавить» и наклоните iPhone на экране блокировки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Dodaj i przechyl iPhone’a na ekranie blokady."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add, then tilt your iPhone on the Lock Screen to see it shift."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Aggiungi, poi inclina l’iPhone sulla schermata di blocco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“添加”，然后在锁定屏幕上倾斜 iPhone 查看效果。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Ajouter, puis inclinez l’iPhone sur l’écran verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Add टैप करें, फिर लॉक स्क्रीन पर iPhone झुकाएँ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Adicionar e incline o iPhone na Tela Bloqueada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가를 탭한 다음 잠금 화면에서 iPhone을 기울여 보세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm Thêm, rồi nghiêng iPhone trên Màn hình khóa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Tambah, lalu miringkan iPhone di Layar Kunci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Tilføj, og vip din iPhone på låseskærmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพิ่ม แล้วเอียง iPhone บนหน้าจอล็อค"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Lägg till och luta din iPhone på låsskärmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Añadir e inclina tu iPhone en la pantalla de bloqueo para verla moverse."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط إضافة، ثم أمِل iPhone على شاشة القفل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點一下「加入」，然後在鎖定畫面上傾斜 iPhone 查看效果。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Legg til, og vipp iPhonen på låst skjerm."
          }
        }
      }
    },
    "spatial.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi görsellerin Uzamsal Sahne'yi desteklediğine iOS karar verir. Hareketi Azalt ve Düşük Güç Modu efekti kapatır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bepaalt welke afbeeldingen ruimtelijke scènes ondersteunen. Verminder beweging en de energiebesparingsmodus zetten het effect uit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空間シーンに対応する画像はiOSが判断します。「視差効果を減らす」と低電力モードでは効果がオフになります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS entscheidet, welche Bilder räumliche Szenen unterstützen. „Bewegung reduzieren“ und der Stromsparmodus schalten den Effekt aus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS сама решает, какие изображения поддерживают пространственную сцену. «Уменьшение движения» и режим энергосбережения отключают эффект."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decyduje, które obrazy obsługują scenę przestrzenną. Ograniczenie ruchu i tryb niskiego zużycia energii wyłączają efekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decides which images support Spatial Scene. Reduce Motion and Low Power Mode turn the effect off."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È iOS a decidere quali immagini supportano la scena spaziale. Riduci movimento e Risparmio energetico disattivano l’effetto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些图片支持空间场景由 iOS 决定。“减弱动态效果”和低电量模式会关闭该效果。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS décide quelles images prennent en charge la scène spatiale. Réduire les animations et le mode économie d’énergie désactivent l’effet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन से चित्र स्पेशियल सीन सपोर्ट करते हैं, यह iOS तय करता है। Reduce Motion और Low Power Mode असर बंद कर देते हैं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS decide quais imagens aceitam Cena Espacial. Reduzir Movimento e o Modo Pouca Energia desativam o efeito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간 장면을 지원하는 이미지는 iOS가 결정합니다. 동작 줄이기와 저전력 모드에서는 효과가 꺼집니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS quyết định ảnh nào hỗ trợ Cảnh không gian. Giảm chuyển động và Chế độ nguồn điện thấp tắt hiệu ứng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS menentukan gambar mana yang mendukung Adegan Spasial. Kurangi Gerakan dan Mode Daya Rendah mematikan efeknya."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bestemmer, hvilke billeder der understøtter rumlig scene. Reducer bevægelse og strømsparetilstand slår effekten fra."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS เป็นผู้ตัดสินว่าภาพใดรองรับฉากเชิงพื้นที่ การลดการเคลื่อนไหวและโหมดประหยัดพลังงานจะปิดเอฟเฟกต์"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS avgör vilka bilder som stöder rumslig scen. Reducera rörelse och strömsparläge stänger av effekten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS decide qué imágenes admiten escena espacial. Reducir movimiento y el modo de bajo consumo desactivan el efecto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرر iOS الصور التي تدعم المشهد المكاني. يوقف «تقليل الحركة» ووضع الطاقة المنخفضة التأثير."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些圖片支援空間場景由 iOS 決定。「減少動態效果」和低耗電模式會關閉此效果。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS bestemmer hvilke bilder som støtter romlig scene. Reduser bevegelse og strømsparingsmodus slår av effekten."
          }
        }
      }
    },
