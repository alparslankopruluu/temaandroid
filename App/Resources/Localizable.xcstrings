          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de développement locale · Services en ligne non connectés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय विकास संस्करण · लाइव सेवाएँ जुड़ी नहीं हैं।"
