    "nightstand.auto.step4": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unu şarja tak. Nightstand son seçtiğin sahneyle açılır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit je iPhone aan. Nightstand opent met je laatste scène."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneを充電器につなぐと、最後に選んだシーンでNightstandが開きます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steck dein iPhone an. Nightstand öffnet sich mit deiner letzten Szene."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите iPhone к зарядке — Nightstand откроется с последней сценой."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz iPhone’a. Nightstand otworzy się z ostatnią sceną."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plug in your iPhone. Nightstand opens with your last scene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega l’iPhone. Nightstand si apre con la tua ultima scena."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给 iPhone 接上充电器，Nightstand 会以你上次的场景打开。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branche ton iPhone. Nightstand s’ouvre avec ta dernière scène."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना iPhone चार्ज पर लगाएं। Nightstand आपके आख़िरी सीन के साथ खुलेगा।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte seu iPhone. O Nightstand abre com sua última cena."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 충전기에 연결하면 마지막 장면으로 Nightstand가 열립니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cắm sạc iPhone. Nightstand sẽ mở với cảnh gần nhất của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Colokkan iPhone Anda. Nightstand terbuka dengan adegan terakhir Anda."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sæt din iPhone til opladning. Nightstand åbner med din seneste scene."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียบชาร์จ iPhone แล้ว Nightstand จะเปิดพร้อมฉากล่าสุดของคุณ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppla in din iPhone. Nightstand öppnas med din senaste scen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu iPhone. Nightstand se abrirá con tu última escena."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِل iPhone بالشاحن. سيفتح Nightstand على آخر مشهد اخترته."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫 iPhone 接上充電器，Nightstand 會以你上次的場景開啟。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koble til iPhonen. Nightstand åpnes med den siste scenen din."
          }
        }
      }
    },
