    "widget.description": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçtiğin tema; fotoğraf, saat, takvim veya koleksiyon kısayoluyla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gekozen thema met een foto, klok, kalender of snelkoppeling naar de collectie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだテーマに、写真、時計、カレンダー、コレクションへのショートカットを組み合わせます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein gewähltes Thema mit Foto, Uhr, Kalender oder Verknüpfung zur Sammlung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная тема с фото, часами, календарём или ссылкой на коллекцию."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój motyw ze zdjęciem, zegarem, kalendarzem lub skrótem do kolekcji."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your selected theme, with a photo, clock, calendar or collection shortcut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tema scelto, con foto, orologio, calendario o collegamento alla collezione."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你选择的主题与照片、时钟、日历或合集快捷方式搭配。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre thème avec une photo, une horloge, un calendrier ou un raccourci vers la collection."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी चुनी थीम के साथ फ़ोटो, घड़ी, कैलेंडर या संग्रह का शॉर्टकट।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu tema escolhido, com foto, relógio, calendário ou atalho para a coleção."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 테마에 사진, 시계, 캘린더 또는 컬렉션 바로가기를 더하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chủ đề bạn chọn cùng ảnh, đồng hồ, lịch hoặc lối tắt bộ sưu tập."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema pilihanmu dengan foto, jam, kalender, atau pintasan koleksi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit valgte tema med foto, ur, kalender eller genvej til samling."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ธีมที่คุณเลือก พร้อมรูปภาพ นาฬิกา ปฏิทิน หรือทางลัดคอลเลกชั่น"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt valda tema med en bild, klocka, kalender eller genväg till samlingen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tema elegido, con foto, reloj, calendario o acceso directo a la colección."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سمتك المختارة مع صورة أو ساعة أو تقويم أو اختصار للمجموعة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的主題，搭配照片、時鐘、行事曆或系列捷徑。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det valgte temaet med bilde, klokke, kalender eller snarvei til samling."
          }
        }
      }
    },
    "widget.selectionHint": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir arka plan seç, ardından ana ekranından ScreenMotion widget’ı ekle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een achtergrond en voeg daarna een ScreenMotion-widget toe vanaf je beginscherm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背景を選び、ホーム画面からScreenMotionウィジェットを追加してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Hintergrund und füge dann auf deinem Home-Bildschirm ein ScreenMotion-Widget hinzu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фон, затем добавьте виджет ScreenMotion с экрана «Домой»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tło, a następnie dodaj widżet ScreenMotion z ekranu początkowego."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a background, then add a ScreenMotion widget from your Home Screen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli uno sfondo, poi aggiungi un widget ScreenMotion dalla schermata Home."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择背景，然后从主屏幕添加ScreenMotion小组件。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fond, puis ajoutez un widget ScreenMotion depuis votre écran d’accueil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड चुनें, फिर होम स्क्रीन से ScreenMotion विजेट जोड़ें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um fundo e adicione um widget do ScreenMotion pela Tela de Início."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배경을 고른 후 홈 화면에서 ScreenMotion 위젯을 추가하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nền, sau đó thêm tiện ích ScreenMotion từ Màn hình chính."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih latar, lalu tambahkan widget ScreenMotion dari Layar Utama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en baggrund, og tilføj en ScreenMotion-widget fra hjemmeskærmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกพื้นหลัง แล้วเพิ่มวิดเจ็ต ScreenMotion จากหน้าจอโฮม"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en bakgrund och lägg sedan till en ScreenMotion-widget från hemskärmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un fondo y añade un widget de ScreenMotion desde tu pantalla de inicio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خلفية ثم أضف أداة ScreenMotion من شاشتك الرئيسية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先選擇背景，再從主畫面加入 ScreenMotion 小工具。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg en bakgrunn, og legg til en ScreenMotion-widget fra Hjem-skjermen."
          }
        }
      }
    },
