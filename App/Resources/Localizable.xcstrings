    "welcome.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin ekranın.\nBiraz daha sen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw scherm.\nEen beetje meer jij."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの画面を、\nもっとあなたらしく。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Bildschirm.\nEin bisschen mehr du."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш экран.\nЧуть больше вас."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój ekran.\nJeszcze bardziej Twój."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your screen.\nA little more you."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo schermo.\nUn po’ più te."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的屏幕，\n更有你的风格。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre écran.\nUn peu plus vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी स्क्रीन।\nआपके रंग में।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua tela.\nUm pouco mais você."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나의 화면.\n조금 더 나답게."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màn hình của bạn.\nĐậm chất bạn hơn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layarmu.\nLebih mencerminkanmu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din skærm.\nLidt mere dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หน้าจอของคุณ\nเป็นคุณมากขึ้นอีกนิด"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din skärm.\nLite mer du."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu pantalla.\nUn poco más tú."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاشتك.\nأقرب إلى شخصيتك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的螢幕，\n更像你一點。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din skjerm.\nLitt mer deg."
          }
        }
      }
    },
    "welcome.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı dünyalar, özenli simgeler ve uyumlu widget’lar. Sana ait hissettiren bir görünüm bul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Levendige werelden, doordachte iconen en bijpassende widgets. Vind een stijl die bij je past."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "息づく世界、こだわりのアイコン、おそろいのウィジェット。自分にしっくりくるスタイルを見つけよう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebendige Welten, liebevolle Icons und passende Widgets. Finde einen Look, der zu dir passt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живые миры, продуманные значки и подходящие виджеты. Найдите образ, который вам близок."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żywe światy, dopracowane ikony i pasujące widżety. Znajdź styl, który do Ciebie pasuje."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Living worlds, thoughtful icons and matching widgets. Find a look that feels like you."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mondi vivi, icone curate e widget coordinati. Trova un look che ti somigli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵动的世界、精心设计的图标和配套小组件。找到与你契合的风格。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des mondes vivants, des icônes soignées et des widgets assortis. Trouvez le style qui vous ressemble."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जीवंत दुनिया, सुंदर आइकन और मेल खाते विजेट। अपना-सा लगने वाला लुक खोजें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mundos vivos, ícones bem pensados e widgets que combinam. Encontre um visual com a sua cara."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "살아 숨 쉬는 세계, 세심한 아이콘, 어울리는 위젯. 나를 닮은 스타일을 찾아보세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thế giới sống động, biểu tượng tinh tế và tiện ích đồng bộ. Tìm phong cách đúng với bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunia yang hidup, ikon menawan, dan widget serasi. Temukan gaya yang terasa seperti dirimu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Levende verdener, gennemtænkte ikoner og matchende widgets. Find et udtryk, der føles som dig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โลกที่มีชีวิต ไอคอนที่ใส่ใจ และวิดเจ็ตที่เข้ากัน ค้นหาลุคที่เป็นคุณ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Levande världar, genomtänkta ikoner och matchande widgetar. Hitta en stil som känns som du."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mundos vivos, iconos cuidados y widgets a juego. Encuentra un estilo que te represente."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عوالم تنبض بالحياة وأيقونات أنيقة وأدوات متناسقة. اختر إطلالة تشبهك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈動世界、精緻圖像與配套小工具。找到屬於你的風格。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Levende verdener, gjennomtenkte ikoner og matchende widgeter. Finn et uttrykk som føles som deg."
          }
        }
      }
    },
