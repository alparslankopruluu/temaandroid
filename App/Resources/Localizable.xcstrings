    "video.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses korunmaz. Kilitli Ekran'da Live Photo oynatma iPhone modeline ve iOS sürümüne bağlıdır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geluid wordt niet bewaard. Of Live Photos op het toegangsscherm afspelen, hangt af van je iPhone-model en iOS-versie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声は保存されません。ロック画面でのLive Photo再生はiPhoneの機種とiOSのバージョンによります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton wird nicht übernommen. Ob Live Photos auf dem Sperrbildschirm abspielen, hängt von iPhone-Modell und iOS-Version ab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук не сохраняется. Воспроизведение Live Photo на экране блокировки зависит от модели iPhone и версии iOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk nie jest zachowywany. Odtwarzanie Live Photos na ekranie blokady zależy od modelu iPhone’a i wersji iOS."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound is not kept. Live Photo playback on the Lock Screen depends on your iPhone model and iOS version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’audio non viene mantenuto. La riproduzione delle Live Photo sulla schermata di blocco dipende dal modello di iPhone e dalla versione di iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会保留声音。锁定屏幕上的实况照片播放取决于 iPhone 机型和 iOS 版本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le son n’est pas conservé. La lecture des Live Photos sur l’écran verrouillé dépend du modèle d’iPhone et de la version d’iOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज़ सेव नहीं होती। लॉक स्क्रीन पर Live Photo चलना iPhone मॉडल और iOS संस्करण पर निर्भर है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O som não é mantido. A reprodução de Live Photo na Tela Bloqueada depende do modelo do iPhone e da versão do iOS."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리는 저장되지 않습니다. 잠금 화면의 Live Photo 재생은 iPhone 모델과 iOS 버전에 따라 다릅니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không giữ âm thanh. Việc phát Live Photo trên Màn hình khóa tùy thuộc vào mẫu iPhone và phiên bản iOS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara tidak disimpan. Pemutaran Live Photo di Layar Kunci bergantung pada model iPhone dan versi iOS."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden gemmes ikke. Afspilning af Live Photos på låseskærmen afhænger af iPhone-model og iOS-version."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงจะไม่ถูกเก็บไว้ การเล่น Live Photo บนหน้าจอล็อคขึ้นอยู่กับรุ่น iPhone และเวอร์ชัน iOS"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet sparas inte. Uppspelning av Live Photos på låsskärmen beror på iPhone-modell och iOS-version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se conserva el sonido. La reproducción de Live Photo en la pantalla de bloqueo depende del modelo de iPhone y la versión de iOS."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحفظ الصوت. يعتمد تشغيل Live Photo على شاشة القفل على طراز iPhone وإصدار iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會保留聲音。鎖定畫面上的原況照片播放取決於 iPhone 機型和 iOS 版本。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyden beholdes ikke. Avspilling av Live Photos på låst skjerm avhenger av iPhone-modell og iOS-versjon."
          }
        }
      }
    },
