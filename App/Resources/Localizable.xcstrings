        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O compartilhamento com widgets não está disponível. Verifique a assinatura do App Group e tente novamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 공유를 이용할 수 없습니다. App Group 서명을 확인한 후 다시 시도해 주세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa thể chia sẻ tiện ích. Kiểm tra cấu hình ký App Group rồi thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbagi widget tidak tersedia. Periksa penandatanganan App Group lalu coba lagi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgetdeling er ikke tilgængelig. Kontrollér App Group-signering, og prøv igen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแชร์วิดเจ็ตไม่พร้อมใช้งาน ตรวจสอบการลงนาม App Group แล้วลองอีกครั้ง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgetdelning är inte tillgänglig. Kontrollera signeringen för App Group och försök igen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La función para compartir con widgets no está disponible. Comprueba la firma de App Group y vuelve a intentarlo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مشاركة الأدوات غير متاحة. تحقّق من إعدادات توقيع App Group ثم حاول مجددًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法共享小工具資料，請檢查 App Group 簽署設定後再試。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Widgetdeling er utilgjengelig. Kontroller App Group-signering og prøv igjen."
          }
        }
      }
    },
