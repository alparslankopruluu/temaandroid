    "pro.lifetime.note": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek ödeme. Abonelik yok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén betaling. Geen abonnement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の支払いのみ。サブスクリプションなし。"
          }
        },
        "de": {
          "stringUnit": {
