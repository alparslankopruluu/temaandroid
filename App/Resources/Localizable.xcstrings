    "ad.testNotice": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geliştirme önizlemesi: ödüllü reklam simülasyonudur. Gerçek reklam gösterilmez ve gelir oluşmaz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontwikkelvoorbeeld: dit simuleert een advertentie met beloning. Er wordt geen echte advertentie getoond of omzet gegenereerd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発用プレビュー：リワード広告のシミュレーションです。実際の広告は表示されず、収益も発生しません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwicklungsvorschau: Hier wird eine belohnte Anzeige simuliert. Es wird keine echte Werbung angezeigt und kein Umsatz erzeugt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр для разработки: имитация рекламы с наградой. Настоящая реклама не показывается, доход не начисляется."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd deweloperski: symulacja reklamy z nagrodą. Nie wyświetla prawdziwej reklamy ani nie generuje przychodu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Development preview: this simulates a rewarded ad. No real ad is shown or revenue generated."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima di sviluppo: simula un annuncio con ricompensa. Non viene mostrata pubblicità reale e non vengono generati ricavi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开发预览：模拟激励广告，不会展示真实广告或产生收入。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu de développement : ceci simule une publicité récompensée. Aucune vraie publicité n’est diffusée et aucun revenu n’est généré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विकास प्रीव्यू: यह इनाम वाले विज्ञापन का अनुकरण है। कोई असली विज्ञापन नहीं दिखाया जाता और आय नहीं होती।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévia de desenvolvimento: simula um anúncio com recompensa. Nenhum anúncio real é exibido nem gera receita."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개발 미리보기: 보상형 광고를 시뮬레이션합니다. 실제 광고는 표시되지 않으며 수익도 발생하지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản xem trước phát triển: mô phỏng quảng cáo có thưởng. Không hiển thị quảng cáo thật hay tạo doanh thu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratinjau pengembangan: ini simulasi iklan berhadiah. Tidak ada iklan nyata atau pendapatan yang dihasilkan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udviklingsvisning: dette simulerer en belønningsreklame. Ingen rigtig reklame vises, og der genereres ingen indtægt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวอย่างสำหรับพัฒนา: จำลองโฆษณาแบบให้รางวัล ไม่มีโฆษณาจริงหรือรายได้เกิดขึ้น"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utvecklingsförhandsvisning: detta simulerar en belöningsannons. Ingen riktig annons visas och inga intäkter genereras."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa de desarrollo: se simula un anuncio con recompensa. No se muestra publicidad real ni se generan ingresos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة تطوير: هذه محاكاة لإعلان بمكافأة. لا يُعرض إعلان حقيقي ولا تُحقّق إيرادات."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開發預覽：此功能模擬獎勵廣告，不會播放真實廣告或產生收益。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Utviklingsvisning: dette simulerer en belønningsreklame. Ingen ekte reklame vises, og ingen inntekt genereres."
          }
        }
      }
    },
