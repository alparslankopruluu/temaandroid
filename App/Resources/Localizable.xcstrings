    "welcome.interact": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunu eğ. Sahneye dokun."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kantel je telefoon. Raak de scène aan."
