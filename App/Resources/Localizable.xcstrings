    "video.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klip seç, en iyi 3 saniyeyi belirle ve Kilitli Ekran'ın için Live Photo olarak kaydet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een clip, selecteer de beste 3 seconden en bewaar die als Live Photo voor je toegangsscherm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップを選び、ベストな3秒を決めて、ロック画面用のLive Photoとして保存します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Clip, such die besten 3 Sekunden aus und sichere sie als Live Photo für deinen Sperrbildschirm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите клип, лучшие 3 секунды и сохраните их как Live Photo для экрана блокировки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz klip, najlepsze 3 sekundy i zapisz je jako Live Photo na ekran blokady."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a clip, choose the best 3 seconds and save it as a Live Photo for your Lock Screen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una clip, seleziona i 3 secondi migliori e salvala come Live Photo per la schermata di blocco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一段视频，挑出最好的 3 秒，存为锁定屏幕的实况照片。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un clip, gardez les 3 meilleures secondes et enregistrez-le en Live Photo pour l’écran verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लिप चुनें, सबसे अच्छे 3 सेकंड चुनें और लॉक स्क्रीन के लिए Live Photo के रूप में सेव करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um clipe, selecione os melhores 3 segundos e salve como Live Photo para a Tela Bloqueada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립을 고르고 가장 좋은 3초를 선택해 잠금 화면용 Live Photo로 저장하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một clip, chọn 3 giây đẹp nhất và lưu thành Live Photo cho Màn hình khóa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih klip, tentukan 3 detik terbaik, lalu simpan sebagai Live Photo untuk Layar Kunci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg et klip, de bedste 3 sekunder, og gem det som Live Photo til låseskærmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกคลิป เลือก 3 วินาทีที่ดีที่สุด แล้วบันทึกเป็น Live Photo สำหรับหน้าจอล็อค"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj ett klipp, de bästa 3 sekunderna och spara som Live Photo för låsskärmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un clip, selecciona los mejores 3 segundos y guárdalo como Live Photo para tu pantalla de bloqueo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مقطعاً وأفضل 3 ثوانٍ واحفظه Live Photo لشاشة القفل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一段影片，挑出最好的 3 秒，儲存為鎖定畫面的原況照片。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg et klipp, de beste 3 sekundene, og arkiver det som Live Photo for låst skjerm."
          }
        }
      }
    },
