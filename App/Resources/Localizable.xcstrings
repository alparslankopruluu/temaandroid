    "pro.timeline.chargeDetail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 24 saat önce iptal etmezsen planın %@ ile başlar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je abonnement start voor %@ tenzij je minstens 24 uur vooraf opzegt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24時間前までにキャンセルしない限り、%@ でプランが始まります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo startet zu %@, wenn du nicht mindestens 24 Stunden vorher kündigst."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка начнётся за %@, если не отменить её минимум за 24 часа."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan zacznie się za %@, chyba że anulujesz co najmniej 24 godziny wcześniej."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your plan starts at %@ unless you cancel at least 24 hours before."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il piano parte a %@ se non annulli almeno 24 ore prima."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非至少提前 24 小时取消，否则将以 %@ 开始订阅。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre formule démarre à %@ sauf si vous annulez au moins 24 heures avant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 24 घंटे पहले रद्द न करने पर आपका प्लान %@ पर शुरू होगा।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu plano começa por %@ se você não cancelar pelo menos 24 horas antes."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소 24시간 전에 취소하지 않으면 %@ 플랜이 시작됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói của bạn bắt đầu với giá %@ trừ khi bạn hủy trước ít nhất 24 giờ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketmu dimulai dengan %@ kecuali kamu batalkan minimal 24 jam sebelumnya."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan starter til %@, medmindre du opsiger mindst 24 timer før."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนของคุณจะเริ่มที่ %@ หากไม่ยกเลิกล่วงหน้าอย่างน้อย 24 ชั่วโมง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din plan startar för %@ om du inte avslutar minst 24 timmar innan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu plan empieza a %@ salvo que canceles al menos 24 horas antes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدأ خطتك بسعر %@ ما لم تلغِ قبل 24 ساعة على الأقل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非至少提前 24 小時取消，否則將以 %@ 開始訂閱。"
          }
        },
        "nb": {
          "stringUnit": {
