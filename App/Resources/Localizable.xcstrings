    "purchase.unavailable": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test ürünleri kullanılamıyor. Uygulamayı Xcode’dan Products.storekit seçili olarak çalıştır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testproducten zijn niet beschikbaar. Start de app vanuit Xcode met Products.storekit geselecteerd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト商品を利用できません。XcodeでProducts.storekitを選択してアプリを起動してください。"
          }
        },
        "de": {
