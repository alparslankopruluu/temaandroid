            "value": "Animasyon oluşturulamadı. Lütfen tekrar dene."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De animatie kon niet worden gemaakt. Probeer het opnieuw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションを作成できませんでした。もう一度お試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Animation konnte nicht erstellt werden. Versuche es erneut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось создать анимацию. Попробуйте ещё раз."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się utworzyć animacji. Spróbuj ponownie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
