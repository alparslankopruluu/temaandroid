    "settings.testBuild": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel geliştirme sürümü · Canlı servisler bağlı değil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale ontwikkelversie · Live diensten zijn niet verbonden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカル開発版・本番サービスには接続していません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Entwicklungsversion · Live-Dienste sind nicht verbunden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная сборка для разработки · Онлайн-сервисы не подключены."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
