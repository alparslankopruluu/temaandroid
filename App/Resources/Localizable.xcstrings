    "spatial.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26'da sabit bir duvar kâğıdı, iPhone'unu eğdikçe kayan bir Uzamsal Sahne'ye dönüşebilir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op iOS 26 kan een stilstaande achtergrond een ruimtelijke scène worden die meebeweegt als je je iPhone kantelt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26では、静止画の壁紙がiPhoneを傾けると動く空間シーンになります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter iOS 26 kann ein Standbild zur räumlichen Szene werden, die sich beim Neigen des iPhone verschiebt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В iOS 26 статичные обои могут стать пространственной сценой, которая смещается при наклоне iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W iOS 26 nieruchoma tapeta może stać się sceną przestrzenną, która przesuwa się, gdy przechylasz iPhone’a."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS 26, a still wallpaper can become a Spatial Scene that shifts as you tilt your iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iOS 26 uno sfondo statico può diventare una scena spaziale che si sposta quando inclini l’iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 26 中，静态墙纸可变成空间场景，随着 iPhone 倾斜而移动。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous iOS 26, un fond fixe peut devenir une scène spatiale qui bouge quand vous inclinez l’iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26 पर स्थिर वॉलपेपर एक स्पेशियल सीन बन सकता है जो iPhone झुकाने पर खिसकता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No iOS 26, um papel de parede estático pode virar uma Cena Espacial que se move quando você inclina o iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 26에서는 정지 배경화면이 iPhone을 기울일 때 움직이는 공간 장면이 될 수 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên iOS 26, hình nền tĩnh có thể thành Cảnh không gian dịch chuyển khi bạn nghiêng iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di iOS 26, wallpaper diam bisa menjadi Adegan Spasial yang bergeser saat iPhone dimiringkan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På iOS 26 kan et stillbillede blive en rumlig scene, der flytter sig, når du vipper din iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน iOS 26 ภาพพื้นหลังนิ่งสามารถเป็นฉากเชิงพื้นที่ที่ขยับตามการเอียง iPhone"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På iOS 26 kan en stillbild bli en rumslig scen som rör sig när du lutar din iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iOS 26, un fondo fijo puede convertirse en una escena espacial que se mueve al inclinar el iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في iOS 26 يمكن أن تصبح الخلفية الثابتة مشهداً مكانياً يتحرك عند إمالة iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS 26 中，靜態背景圖片可變成空間場景，隨 iPhone 傾斜而移動。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I iOS 26 kan et stillbilde bli en romlig scene som forskyves når du vipper iPhonen."
          }
        }
      }
    },
    "spatial.requires": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzamsal Sahne için iOS 26 veya üstü gerekir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruimtelijke scènes vereisen iOS 26 of nieuwer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空間シーンにはiOS 26以降が必要です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Räumliche Szenen benötigen iOS 26 oder neuer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для пространственной сцены нужна iOS 26 или новее."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scena przestrzenna wymaga iOS 26 lub nowszego."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spatial Scene needs iOS 26 or later."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scena spaziale richiede iOS 26 o successivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间场景需要 iOS 26 或更高版本。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La scène spatiale nécessite iOS 26 ou version ultérieure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पेशियल सीन के लिए iOS 26 या बाद का संस्करण चाहिए।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Cena Espacial exige iOS 26 ou posterior."
          }
        },
