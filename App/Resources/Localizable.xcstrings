    "nightstand.auto.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightstand'i şarj ekranın yap. Kestirmeler otomasyonu, şarja her taktığında onu açabilir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak Nightstand je oplaadscherm. Een Opdrachten-automatisering opent het telkens als je de lader aansluit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightstandを充電画面にしましょう。ショートカットのオートメーションで充電のたびに開けます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach Nightstand zu deinem Ladebildschirm. Eine Kurzbefehle-Automation öffnet es bei jedem Anstecken."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте Nightstand экраном зарядки. Автоматизация в «Командах» откроет его при каждом подключении."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw Nightstand jako ekran ładowania. Automatyzacja Skrótów może go otwierać przy każdym podłączeniu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make Nightstand your charging screen. A Shortcuts automation can open it every time you plug in."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendi Nightstand la tua schermata di ricarica. Un’automazione di Comandi Rapidi può aprirla ogni volta che colleghi il caricatore."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Nightstand 设为充电画面。快捷指令自动化可在每次接上充电器时打开它。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais de Nightstand ton écran de recharge. Une automatisation Raccourcis peut l’ouvrir à chaque branchement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightstand को अपनी चार्जिंग स्क्रीन बनाएं। शॉर्टकट ऑटोमेशन हर बार चार्जर लगाने पर इसे खोल सकता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça do Nightstand sua tela de carregamento. Uma automação de Atalhos pode abri-lo sempre que você conectar o carregador."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Nightstand를 충전 화면으로 만들어 보세요. 단축어 자동화가 충전기를 연결할 때마다 열어 줍니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến Nightstand thành màn hình sạc. Một mục tự động hóa Phím tắt có thể mở nó mỗi khi bạn cắm sạc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadikan Nightstand layar pengisian daya. Otomatisasi Pintasan dapat membukanya setiap kali Anda mencolokkan pengisi daya."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gør Nightstand til din opladningsskærm. En Genveje-automatisering kan åbne den, hver gang du sætter i stikket."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Nightstand เป็นหน้าจอขณะชาร์จ ระบบอัตโนมัติในคำสั่งลัดเปิดให้ได้ทุกครั้งที่เสียบสาย"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gör Nightstand till din laddskärm. En Genvägar-automation kan öppna den varje gång du kopplar in laddaren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz de Nightstand tu pantalla de carga. Una automatización de Atajos puede abrirlo cada vez que conectes el cargador."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجعل Nightstand شاشة الشحن. يمكن لأتمتة الاختصارات فتحه في كل مرة توصل فيها الشاحن."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把 Nightstand 設為充電畫面。捷徑自動化可在每次接上充電器時打開它。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør Nightstand til ladeskjermen din. En Snarveier-automatisering kan åpne den hver gang du kobler til."
          }
        }
      }
    },
    "nightstand.auto.step1": {
      "localizations": {
        "tr": {
          "stringUnit": {
