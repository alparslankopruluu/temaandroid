    "install.wallpaper.1": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar → Duvar Kâğıdı → Yeni Duvar Kâğıdı Ekle yolunu aç. Fotoğraflar’ı seç ve kaydettiğin görseli bul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Instellingen → Achtergrond → Voeg nieuwe achtergrond toe. Kies Foto's en selecteer het bewaarde beeld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定 → 壁紙 → 新しい壁紙を追加を開きます。「写真」を選び、保存した画像を選択してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Einstellungen → Hintergrundbild → Neues Hintergrundbild auswählen. Wähle Fotos und dann dein gespeichertes Bild."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте «Настройки» → «Обои» → «Добавить новые обои». Выберите «Фото» и сохранённое изображение."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Ustawienia → Tapeta → Dodaj nową tapetę. Wybierz Zdjęcia i zapisany obraz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings → Wallpaper → Add New Wallpaper. Choose Photos and select the image you saved."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Impostazioni → Sfondo → Aggiungi un nuovo sfondo. Scegli Foto e seleziona l’immagine salvata."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置 → 墙纸 → 添加新墙纸。选择“照片”，然后选取你保存的图片。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Réglages → Fond d’écran → Ajouter un fond d’écran. Choisissez Photos, puis sélectionnez l’image enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्ज़ → वॉलपेपर → नया वॉलपेपर जोड़ें खोलें। फ़ोटो चुनें और अपनी सहेजी तस्वीर चुनें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Ajustes → Imagem de Fundo → Adicionar Nova Imagem de Fundo. Escolha Fotos e selecione a imagem salva."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 → 배경화면 → 새로운 배경화면 추가를 여세요. 사진을 선택한 후 저장한 이미지를 고르세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Cài đặt → Hình nền → Thêm hình nền mới. Chọn Ảnh rồi chọn ảnh bạn đã lưu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan → Wallpaper → Tambah Wallpaper Baru. Pilih Foto lalu gambar yang telah disimpan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Indstillinger → Baggrund → Tilføj ny baggrund. Vælg Fotos og det gemte billede."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดการตั้งค่า → ภาพพื้นหลัง → เพิ่มภาพพื้นหลังใหม่ เลือกรูปภาพ แล้วเลือกภาพที่บันทึกไว้"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Inställningar → Bakgrundsbild → Lägg till ny bakgrundsbild. Välj Bilder och sedan bilden du sparade."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Ajustes → Fondo de pantalla → Añadir nuevo fondo de pantalla. Elige Fotos y selecciona la imagen que guardaste."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الإعدادات ← خلفية الشاشة ← إضافة خلفية جديدة. اختر الصور ثم حدّد الصورة التي حفظتها."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟「設定」→「背景圖片」→「加入新的背景圖片」。選擇「照片」，再選取已儲存的圖片。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Innstillinger → Bakgrunn → Legg til ny bakgrunn. Velg Bilder og bildet du lagret."
          }
        }
      }
    },
    "install.wallpaper.2": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo için iOS sunuyorsa hareketi aç. Uygun görsellerde Uzamsal Sahne’yi dene. Kadrajı ve saati sistem düzenleyicisinde ayarla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel beweging in voor een Live Photo als iOS die optie aanbiedt. Probeer een ruimtelijke scène bij een geschikt beeld. Pas de uitsnede en klok aan in de systeemeditor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photoでは、iOSにオプションが表示される場合に動きを有効にします。対応する画像では空間シーンも試せます。システムの編集画面でトリミングと時計を調整してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere bei einem Live Photo die Bewegung, falls iOS sie anbietet. Probiere bei geeigneten Bildern eine räumliche Szene. Passe Bildausschnitt und Uhr im Systemeditor an."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Live Photo включите движение, если iOS предлагает эту функцию. Для совместимых изображений попробуйте пространственную сцену. Настройте кадрирование и часы в системном редакторе."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przypadku Live Photo włącz ruch, jeśli iOS udostępnia tę opcję. Wypróbuj scenę przestrzenną dla zgodnego obrazu. Dostosuj kadr i zegar w edytorze systemowym."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a Live Photo, enable motion if iOS offers it. For an eligible image, try Spatial Scene. Adjust the crop and clock in the system editor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per una Live Photo, attiva il movimento se iOS lo propone. Per le immagini compatibili, prova Scena spaziale. Regola inquadratura e orologio nell’editor di sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于实况照片，如果iOS提供动效选项，请将其启用。对于支持的图片，可以尝试“空间场景”。在系统编辑器中调整裁剪和时钟。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour une Live Photo, activez le mouvement si iOS le propose. Essayez Scène spatiale pour les images compatibles. Ajustez le cadrage et l’horloge dans l’éditeur système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo के लिए iOS विकल्प दे तो गति चालू करें। योग्य तस्वीर पर स्थानिक दृश्य आज़माएँ। सिस्टम एडिटर में क्रॉप और घड़ी बदलें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para uma Live Photo, ative o movimento se o iOS oferecer a opção. Em imagens compatíveis, experimente Cena Espacial. Ajuste o enquadramento e o relógio no editor do sistema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo는 iOS에서 옵션을 제공하는 경우 움직임을 켜세요. 지원되는 이미지에서는 공간 장면을 사용해 보세요. 시스템 편집기에서 자르기와 시계를 조정하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với Live Photo, bật chuyển động nếu iOS có tùy chọn này. Thử Cảnh không gian với ảnh đủ điều kiện. Điều chỉnh khung cắt và đồng hồ trong trình sửa của hệ thống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk Live Photo, aktifkan gerakan jika tersedia di iOS. Coba Adegan Spasial pada gambar yang mendukungnya. Atur potongan dan jam di editor sistem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For et Live Photo skal du aktivere bevægelse, hvis iOS tilbyder det. Prøv rumlig scene med et egnet billede. Juster beskæring og ur i systemets editor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำหรับ Live Photo ให้เปิดการเคลื่อนไหวหาก iOS มีตัวเลือกนี้ ลองฉากเชิงมิติสำหรับภาพที่รองรับ ปรับการครอบตัดและนาฬิกาในตัวแก้ไขของระบบ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera rörelse för en Live Photo om iOS erbjuder det. Prova en rumslig scen för en bild som stöds. Justera beskärning och klocka i systemredigeraren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para una Live Photo, activa el movimiento si iOS lo permite. Con una imagen compatible, prueba Escena espacial. Ajusta el encuadre y el reloj en el editor del sistema."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لصورة Live Photo، فعّل الحركة إذا أتاحها iOS. جرّب المشهد المكاني للصور المتوافقة. اضبط الاقتصاص والساعة في محرّر النظام."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若是原況照片，請在 iOS 提供選項時啟用動態。符合資格的圖片可嘗試空間場景。在系統編輯器中調整裁切與時鐘。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For et Live Photo aktiverer du bevegelse hvis iOS tilbyr det. Prøv romlig scene med et egnet bilde. Juster beskjæring og klokke i systemets redigering."
          }
        }
      }
    },
    "install.wallpaper.3": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekle’ye dokun, ardından Duvar Kâğıdı Çifti Olarak Ayarla’yı seç veya ana ekranını özelleştir. Sonucu görmek için telefonunu uyandır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Voeg toe en kies daarna Stel in als achtergrondpaar of pas je beginscherm aan. Activeer je telefoon om het resultaat te bekijken."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「追加」をタップし、「壁紙を両方に設定」を選ぶか、ホーム画面をカスタマイズします。スマホのスリープを解除して仕上がりを確認しましょう。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Hinzufügen und wähle Als Hintergrundbildpaar festlegen oder passe deinen Home-Bildschirm an. Aktiviere dein Handy, um das Ergebnis zu prüfen."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Добавить», затем выберите «Сделать парой обоев» или настройте экран «Домой». Разбудите телефон, чтобы проверить результат."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Dodaj, a następnie Ustaw jako parę tapet lub dostosuj ekran początkowy. Wybudź telefon, by sprawdzić efekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Add, then choose Set as Wallpaper Pair or customize your Home Screen. Wake your phone to check the result."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Aggiungi, poi Imposta come coppia di sfondi oppure personalizza la schermata Home. Riattiva il telefono per controllare il risultato."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点“添加”，然后选择“设为墙纸对”或自定主屏幕。唤醒手机，查看效果。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Ajouter, puis Définir comme paire de fonds d’écran ou personnalisez votre écran d’accueil. Réveillez votre téléphone pour vérifier le résultat."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ें पर टैप करें, फिर वॉलपेपर जोड़ी के रूप में सेट करें चुनें या होम स्क्रीन बदलें। परिणाम देखने के लिए फ़ोन जगाएँ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Adicionar e escolha Definir como Par de Imagens de Fundo ou personalize a Tela de Início. Desperte o celular para conferir o resultado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가를 누른 다음 한 쌍의 배경화면으로 설정을 선택하거나 홈 화면을 사용자화하세요. 휴대폰을 깨워 결과를 확인하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm Thêm, rồi chọn Đặt làm cặp hình nền hoặc tùy chỉnh Màn hình chính. Đánh thức điện thoại để kiểm tra kết quả."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Tambah, lalu pilih Atur sebagai Pasangan Wallpaper atau sesuaikan Layar Utama. Bangunkan ponsel untuk melihat hasilnya."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Tilføj, og vælg et baggrundspar, eller tilpas hjemmeskærmen. Væk telefonen for at se resultatet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะเพิ่ม แล้วเลือกตั้งค่าเป็นคู่ภาพพื้นหลังหรือปรับแต่งหน้าจอโฮม ปลุกโทรศัพท์เพื่อตรวจดูผลลัพธ์"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Lägg till och välj sedan Ställ in som bakgrundspar eller anpassa hemskärmen. Väck telefonen för att se resultatet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Añadir y elige Definir como pareja de fondos o personaliza tu pantalla de inicio. Activa el teléfono para comprobar el resultado."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على إضافة، ثم اختر التعيين كزوج خلفيات أو خصّص شاشتك الرئيسية. أيقظ هاتفك للتحقّق من النتيجة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「加入」，再選擇「設為背景圖片組合」或自訂主畫面。喚醒手機確認效果。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Legg til, og velg et bakgrunnspar eller tilpass Hjem-skjermen. Vekk telefonen for å se resultatet."
          }
        }
      }
    },
    "install.icons.1": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simge paketini dışa aktar ve klasörü Dosyalar’a kaydet. Özelleştirmek istediğin uygulamanın görselini seç."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer het iconenpakket en bewaar de map in Bestanden. Kies het beeld voor de app die je wilt aanpassen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンパックを書き出し、フォルダを「ファイル」に保存します。変更したいアプリに使う画像を選んでください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere das Icon-Paket und speichere den Ordner in Dateien. Wähle das Bild für die App, die du anpassen möchtest."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте набор значков и сохраните папку в «Файлы». Выберите изображение для приложения, которое хотите оформить."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyeksportuj pakiet ikon i zapisz folder w Plikach. Wybierz obraz dla aplikacji, którą chcesz dostosować."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export the icon pack and save the folder to Files. Choose the image for the app you want to customize."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta il pacchetto icone e salva la cartella in File. Scegli l’immagine per l’app che vuoi personalizzare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出图标包并将文件夹保存到“文件”。选择要用于自定App的图片。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez le pack d’icônes et enregistrez le dossier dans Fichiers. Choisissez l’image de l’app à personnaliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइकन पैक एक्सपोर्ट करें और फ़ोल्डर को फ़ाइल में सहेजें। जिस ऐप को बदलना है, उसकी तस्वीर चुनें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte o pacote de ícones e salve a pasta em Arquivos. Escolha a imagem do app que deseja personalizar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘 팩을 내보내고 폴더를 파일에 저장하세요. 꾸미려는 앱에 사용할 이미지를 선택하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất bộ biểu tượng và lưu thư mục vào Tệp. Chọn ảnh cho ứng dụng bạn muốn tùy chỉnh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor paket ikon dan simpan folder ke File. Pilih gambar untuk aplikasi yang ingin disesuaikan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportér ikonpakken, og gem mappen i Arkiver. Vælg billedet til den app, du vil tilpasse."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งออกชุดไอคอนแล้วบันทึกโฟลเดอร์ไปยังไฟล์ เลือกภาพสำหรับแอปที่ต้องการปรับแต่ง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportera ikonpaketet och spara mappen i Filer. Välj bilden för appen du vill anpassa."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta el paquete de iconos y guarda la carpeta en Archivos. Elige la imagen para la app que quieras personalizar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدّر حزمة الأيقونات واحفظ المجلد في الملفات. اختر صورة التطبيق الذي تريد تخصيصه."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯出圖像套組並將資料夾儲存至「檔案」。選擇要自訂之 App 的圖片。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporter ikonpakken og lagre mappen i Filer. Velg bildet til appen du vil tilpasse."
          }
        }
      }
    },
    "install.icons.2": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kestirmeler’de Uygulamayı Aç eylemi oluştur ve uygulamayı seç. Menüsünü açıp Ana Ekrana Ekle’yi seç."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak in Opdrachten de actie Open app aan en kies de app. Open het menu en kies Zet op beginscherm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ショートカット」で「アプリを開く」アクションを作成し、アプリを選びます。メニューを開き、「ホーム画面に追加」を選択してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle in Kurzbefehle eine Aktion App öffnen und wähle die App. Öffne das Menü und wähle Zum Home-Bildschirm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В «Командах» создайте действие «Открыть приложение» и выберите приложение. Откройте меню и выберите «На экран Домой»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Skrótach utwórz czynność Otwórz aplikację i wybierz aplikację. Otwórz menu i wybierz Do ekranu początkowego."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Shortcuts, create an Open App action and choose the app. Open its menu and select Add to Home Screen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Comandi Rapidi, crea un’azione Apri app e scegli l’applicazione. Apri il menu e seleziona Aggiungi alla schermata Home."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“快捷指令”中创建“打开App”操作并选择App。打开菜单，选择“添加到主屏幕”。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Raccourcis, créez une action Ouvrir l’app et choisissez l’application. Ouvrez son menu et sélectionnez Sur l’écran d’accueil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट में ऐप खोलें क्रिया बनाएँ और ऐप चुनें। मेनू खोलकर होम स्क्रीन में जोड़ें चुनें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em Atalhos, crie uma ação Abrir App e escolha o aplicativo. Abra o menu e selecione Adicionar à Tela de Início."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축어에서 앱 열기 동작을 만들고 앱을 선택하세요. 메뉴를 열어 홈 화면에 추가를 선택하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Phím tắt, tạo tác vụ Mở ứng dụng và chọn ứng dụng. Mở menu và chọn Thêm vào Màn hình chính."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Pintasan, buat tindakan Buka App lalu pilih aplikasinya. Buka menu dan pilih Tambah ke Layar Utama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opret handlingen Åbn app i Genveje, og vælg appen. Åbn menuen, og vælg Føj til hjemmeskærm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแอปคำสั่งลัด สร้างการทำงานเปิดแอป แล้วเลือกแอป เปิดเมนูแล้วเลือกเพิ่มไปยังหน้าจอโฮม"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa åtgärden Öppna app i Genvägar och välj appen. Öppna menyn och välj Lägg till på hemskärmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Atajos, crea una acción Abrir app y elige la aplicación. Abre su menú y selecciona Añadir a pantalla de inicio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الاختصارات، أنشئ إجراء فتح تطبيق واختر التطبيق. افتح قائمته واختر إضافة إلى الشاشة الرئيسية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「捷徑」中建立「打開 App」動作並選擇 App。開啟選單，選取「加入主畫面」。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opprett handlingen Åpne app i Snarveier og velg appen. Åpne menyen og velg Legg til på Hjem-skjerm."
          }
        }
      }
    },
    "install.icons.3": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simgeye dokun, kaydettiğin görseli seç ve ad ver. Ekle’ye dokun. Diğer uygulamalar için tekrarla; asıl uygulama simgeleri değişmez."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op het icoon, kies je bewaarde beeld en geef het een naam. Tik op Voeg toe. Herhaal voor andere apps; de oorspronkelijke appiconen blijven ongewijzigd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンをタップし、保存した画像を選んで名前を付け、「追加」をタップします。他のアプリも同じ手順で設定できます。元のアプリアイコンは変更されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Icon, wähle dein gespeichertes Bild und gib einen Namen ein. Tippe auf Hinzufügen. Wiederhole dies für weitere Apps; die ursprünglichen App-Icons bleiben unverändert."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на значок, выберите сохранённое изображение и задайте имя. Нажмите «Добавить». Повторите для других приложений; их исходные значки не изменятся."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij ikonę, wybierz zapisany obraz i nadaj nazwę. Stuknij Dodaj. Powtórz dla innych aplikacji; ich oryginalne ikony się nie zmienią."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the icon, choose your saved image and give it a name. Tap Add. Repeat for your other apps; original app icons are unchanged."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca l’icona, scegli l’immagine salvata e assegna un nome. Tocca Aggiungi. Ripeti per le altre app; le icone originali restano invariate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点图标，选取保存的图片并为其命名，再轻点“添加”。对其他App重复操作；原始App图标不会改变。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez l’icône, choisissez votre image et donnez-lui un nom. Touchez Ajouter. Répétez pour les autres apps ; leurs icônes d’origine ne changent pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आइकन पर टैप करें, सहेजी तस्वीर चुनें और नाम दें। जोड़ें पर टैप करें। दूसरे ऐप के लिए दोहराएँ; मूल आइकन नहीं बदलते।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no ícone, escolha a imagem salva e dê um nome. Toque em Adicionar. Repita nos outros apps; os ícones originais não são alterados."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이콘을 누르고 저장한 이미지를 선택한 후 이름을 지정하세요. 추가를 누르세요. 다른 앱도 반복해 설정할 수 있으며 원래 앱 아이콘은 바뀌지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm biểu tượng, chọn ảnh đã lưu và đặt tên. Chạm Thêm. Lặp lại cho ứng dụng khác; biểu tượng gốc không thay đổi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk ikon, pilih gambar tersimpan, dan beri nama. Ketuk Tambah. Ulangi untuk aplikasi lain; ikon asli tidak berubah."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på ikonet, vælg dit gemte billede, og giv det et navn. Tryk på Tilføj. Gentag for andre apps; de oprindelige ikoner ændres ikke."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะไอคอน เลือกภาพที่บันทึกไว้และตั้งชื่อ แตะเพิ่ม ทำซ้ำสำหรับแอปอื่น ไอคอนเดิมจะไม่เปลี่ยนแปลง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ikonen, välj din sparade bild och ge den ett namn. Tryck på Lägg till. Upprepa för andra appar; de ursprungliga appikonerna ändras inte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el icono, elige la imagen guardada y ponle un nombre. Toca Añadir. Repite con las demás apps; sus iconos originales no cambian."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الأيقونة، واختر الصورة المحفوظة وسمّها. اضغط على إضافة. كرّر ذلك لباقي تطبيقاتك؛ لن تتغيّر أيقونات التطبيقات الأصلية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按圖像、選擇已儲存的圖片並命名，再點按「加入」。其他 App 可重複此操作，原有 App 圖像不會改變。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på ikonet, velg bildet du lagret og gi det et navn. Trykk på Legg til. Gjenta for andre apper; de opprinnelige ikonene endres ikke."
          }
        }
      }
    },
    "install.widgets.1": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenMotion’da widget arka planını seç. Ana ekranda boş bir alana basılı tut."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je widgetachtergrond in ScreenMotion. Houd een lege plek op het beginscherm ingedrukt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenMotionでウィジェットの背景を選びます。ホーム画面の空いている場所を長押ししてください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle deinen Widget-Hintergrund in ScreenMotion. Halte auf dem Home-Bildschirm einen leeren Bereich gedrückt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите фон виджета в ScreenMotion. На экране «Домой» нажмите и удерживайте пустую область."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tło widżetu w ScreenMotion. Na ekranie początkowym przytrzymaj puste miejsce."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your widget background in ScreenMotion. On the Home Screen, touch and hold an empty area."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli lo sfondo del widget in ScreenMotion. Tieni premuta un’area vuota della schermata Home."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在ScreenMotion中选择小组件背景。在主屏幕上按住空白区域。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le fond du widget dans ScreenMotion. Maintenez le doigt sur une zone vide de l’écran d’accueil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenMotion में विजेट बैकग्राउंड चुनें। होम स्क्रीन पर खाली जगह को छूकर दबाए रखें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o fundo do widget no ScreenMotion. Na Tela de Início, mantenha uma área vazia pressionada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenMotion에서 위젯 배경을 선택하세요. 홈 화면의 빈 공간을 길게 누르세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn nền tiện ích trong ScreenMotion. Trên Màn hình chính, chạm và giữ một vùng trống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih latar widget di ScreenMotion. Di Layar Utama, sentuh dan tahan area kosong."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg widgetbaggrund i ScreenMotion. Hold fingeren på et tomt område på hjemmeskærmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกพื้นหลังวิดเจ็ตใน ScreenMotion จากนั้นแตะค้างบนพื้นที่ว่างของหน้าจอโฮม"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj widgetbakgrund i ScreenMotion. Håll på ett tomt område på hemskärmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el fondo del widget en ScreenMotion. Mantén pulsada una zona vacía de la pantalla de inicio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خلفية الأداة في ScreenMotion. المس مطولًا مساحة فارغة على الشاشة الرئيسية."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 ScreenMotion 選擇小工具背景。在主畫面按住空白區域。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg widgetbakgrunn i ScreenMotion. Hold fingeren på et tomt område på Hjem-skjermen."
          }
        }
      }
    },
    "install.widgets.2": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenle → Widget Ekle’ye dokun, ScreenMotion’ı bul, bir boyut seç ve Widget Ekle’ye dokun. Eski iOS sürümlerinde + düğmesini kullan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op Wijzig → Voeg widget toe, zoek ScreenMotion, kies een formaat en tik op Voeg widget toe. Gebruik op oudere iOS-versies de knop +."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集 → ウィジェットを追加をタップし、ScreenMotionを探します。サイズを選び、「ウィジェットを追加」をタップしてください。古いiOSでは「＋」ボタンを使います。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf Bearbeiten → Widget hinzufügen, suche ScreenMotion, wähle eine Größe und tippe auf Widget hinzufügen. Verwende unter älteren iOS-Versionen die Taste +."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите «Править» → «Добавить виджет», найдите ScreenMotion, выберите размер и нажмите «Добавить виджет». В старых версиях iOS используйте кнопку +."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij Edytuj → Dodaj widżet, znajdź ScreenMotion, wybierz rozmiar i stuknij Dodaj widżet. W starszych wersjach iOS użyj przycisku +."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Edit → Add Widget, find ScreenMotion, choose a size and tap Add Widget. On older iOS versions, use the + button."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca Modifica → Aggiungi widget, cerca ScreenMotion, scegli una dimensione e tocca Aggiungi widget. Nelle versioni precedenti di iOS, usa il pulsante +."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点编辑 → 添加小组件，找到ScreenMotion，选择尺寸并轻点“添加小组件”。在较旧的iOS版本中，请使用“+”按钮。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez Modifier → Ajouter un widget, trouvez ScreenMotion, choisissez une taille et touchez Ajouter le widget. Sur les anciennes versions d’iOS, utilisez le bouton +."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादित करें → विजेट जोड़ें पर टैप करें, ScreenMotion खोजें, आकार चुनें और विजेट जोड़ें पर टैप करें। पुराने iOS पर + बटन इस्तेमाल करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Editar → Adicionar Widget, encontre ScreenMotion, escolha um tamanho e toque em Adicionar Widget. Em versões anteriores do iOS, use o botão +."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집 → 위젯 추가를 누르고 ScreenMotion을 찾으세요. 크기를 고른 후 위젯 추가를 누르세요. 이전 iOS 버전에서는 + 버튼을 사용하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm Sửa → Thêm tiện ích, tìm ScreenMotion, chọn kích thước rồi chạm Thêm tiện ích. Với iOS cũ, dùng nút +."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk Edit → Tambah Widget, cari ScreenMotion, pilih ukuran, lalu ketuk Tambah Widget. Pada iOS lama, gunakan tombol +."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på Rediger → Tilføj widget, find ScreenMotion, vælg størrelse, og tilføj widgetten. På ældre iOS-versioner bruges knappen +."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะแก้ไข → เพิ่มวิดเจ็ต ค้นหา ScreenMotion เลือกขนาดแล้วแตะเพิ่มวิดเจ็ต สำหรับ iOS รุ่นเก่าให้ใช้ปุ่ม +"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på Redigera → Lägg till widget, hitta ScreenMotion, välj storlek och tryck på Lägg till widget. Använd knappen + på äldre iOS-versioner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca Editar → Añadir widget, busca ScreenMotion, elige un tamaño y toca Añadir widget. En versiones anteriores de iOS, usa el botón +."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على تعديل ← إضافة أداة، وابحث عن ScreenMotion، واختر حجمًا ثم اضغط على إضافة أداة. في إصدارات iOS الأقدم، استخدم زر +."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點按「編輯」→「加入小工具」，找到 ScreenMotion、選擇尺寸，再點按「加入小工具」。舊版 iOS 請使用 + 按鈕。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på Rediger → Legg til widget, finn ScreenMotion, velg størrelse og legg til widgeten. På eldre iOS-versjoner brukes knappen +."
          }
        }
      }
    },
    "install.widgets.3": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Widget’a basılı tut → Widget’ı Düzenle’den Fotoğraf, Saat ve Tarih, Takvim veya Koleksiyon’u seç. Kilit ekranı widget’ları sistemin kilit ekranı düzenleyicisinden eklenir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de widget ingedrukt → Wijzig widget om Foto, Klok en datum, Kalender of Collectie te kiezen. Widgets voor het toegangsscherm voeg je toe in de systeemeditor voor het toegangsscherm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットを長押し → ウィジェットを編集から、写真、時計と日付、カレンダー、コレクションを選びます。ロック画面のウィジェットは、iOSのロック画面編集で追加します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte das Widget gedrückt → Widget bearbeiten, um Foto, Uhr & Datum, Kalender oder Sammlung zu wählen. Sperrbildschirm-Widgets fügst du im Sperrbildschirmeditor von iOS hinzu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте виджет → «Изменить виджет», чтобы выбрать «Фото», «Часы и дата», «Календарь» или «Коллекция». Виджеты экрана блокировки добавляются в системном редакторе экрана блокировки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj widżet → Edytuj widżet, aby wybrać Zdjęcie, Zegar i datę, Kalendarz lub Kolekcję. Widżety ekranu blokady dodasz w systemowym edytorze ekranu blokady."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the widget → Edit Widget to choose Photo, Clock & Date, Calendar or Collection. Lock Screen widgets are added in the system Lock Screen editor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto il widget → Modifica widget per scegliere Foto, Orologio e data, Calendario o Collezione. I widget della schermata di blocco si aggiungono dall’editor della schermata di blocco del sistema."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住小组件 → 编辑小组件，选择照片、时钟与日期、日历或合集。锁定屏幕小组件需在系统的锁定屏幕编辑器中添加。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez le doigt sur le widget → Modifier le widget pour choisir Photo, Horloge et date, Calendrier ou Collection. Les widgets de l’écran verrouillé s’ajoutent dans l’éditeur de l’écran verrouillé du système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विजेट दबाए रखें → विजेट संपादित करें में फ़ोटो, घड़ी और तारीख़, कैलेंडर या संग्रह चुनें। लॉक स्क्रीन विजेट सिस्टम के लॉक स्क्रीन एडिटर में जोड़े जाते हैं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o widget pressionado → Editar Widget para escolher Foto, Relógio e Data, Calendário ou Coleção. Widgets da Tela Bloqueada são adicionados no editor da Tela Bloqueada do sistema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 길게 누르고 위젯 편집에서 사진, 시계 및 날짜, 캘린더 또는 컬렉션을 선택하세요. 잠금 화면 위젯은 시스템 잠금 화면 편집기에서 추가합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm và giữ tiện ích → Sửa tiện ích để chọn Ảnh, Đồng hồ và ngày, Lịch hoặc Bộ sưu tập. Thêm tiện ích Màn hình khóa trong trình sửa Màn hình khóa của hệ thống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentuh dan tahan widget → Edit Widget untuk memilih Foto, Jam & Tanggal, Kalender, atau Koleksi. Tambahkan widget Layar Kunci melalui editor Layar Kunci sistem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på widgetten → Rediger widget for at vælge foto, ur og dato, kalender eller samling. Låseskærmswidgets tilføjes i systemets låseskærmseditor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะวิดเจ็ตค้างไว้ → แก้ไขวิดเจ็ต เพื่อเลือกรูปภาพ นาฬิกาและวันที่ ปฏิทิน หรือคอลเลกชั่น เพิ่มวิดเจ็ตหน้าจอล็อคในตัวแก้ไขหน้าจอล็อคของระบบ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll på widgeten → Ändra widget för att välja Bild, Klocka och datum, Kalender eller Samling. Låsskärmswidgetar läggs till i systemets låsskärmsredigerare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado el widget → Editar widget para elegir Foto, Reloj y fecha, Calendario o Colección. Los widgets de la pantalla de bloqueo se añaden en el editor de la pantalla de bloqueo del sistema."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس الأداة مطولًا ← تعديل الأداة لاختيار صورة أو الساعة والتاريخ أو التقويم أو المجموعة. تُضاف أدوات شاشة القفل من محرّر شاشة القفل في النظام."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住小工具→「編輯小工具」，選擇照片、時鐘與日期、行事曆或系列。鎖定畫面小工具需在系統鎖定畫面編輯器中加入。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren på widgeten → Rediger widget for å velge bilde, klokke og dato, kalender eller samling. Widgeter på låst skjerm legges til i systemets låseskjermredigering."
          }
        }
      }
    },
