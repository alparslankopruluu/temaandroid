    "pro.subtitle": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm hareketli sahnelerin kilidini aç, kendi videolarını Live Photo'ya dönüştür."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel alle bewegende scènes en maak van je eigen video’s Live Photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動くシーンをすべて解放し、自分の動画をLive Photoにできます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte alle bewegten Szenen frei und mach deine eigenen Videos zu Live Photos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте все живые сцены и превращайте свои видео в Live Photo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj wszystkie ruchome sceny i zamieniaj własne filmy w Live Photos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock every moving scene and turn your own videos into Live Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca tutte le scene animate e trasforma i tuoi video in Live Photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁所有动态场景，并把你的视频变成实况照片。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez toutes les scènes animées et transformez vos vidéos en Live Photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी चलते सीन अनलॉक करें और अपने वीडियो को Live Photo बनाएँ।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie todas as cenas em movimento e transforme seus vídeos em Live Photos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "움직이는 모든 장면을 열고 내 동영상을 Live Photo로 만드세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa mọi cảnh chuyển động và biến video của bạn thành Live Photo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka semua adegan bergerak dan ubah videomu jadi Live Photo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås alle levende scener op, og gør dine egne videoer til Live Photos."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อกทุกฉากเคลื่อนไหว และเปลี่ยนวิดีโอของคุณเป็น Live Photo"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås upp alla rörliga scener och gör dina egna videor till Live Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea todas las escenas en movimiento y convierte tus videos en Live Photos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح كل المشاهد المتحركة وحوّل مقاطعك إلى Live Photo."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖所有動態場景，並把你的影片變成原況照片。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås opp alle levende scener, og gjør dine egne videoer om til Live Photos."
          }
        }
      }
    },
