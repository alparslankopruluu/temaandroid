    "pro.terms.lifetime": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma. Aynı Apple Hesabı ile giriş yapılan cihazlarda istediğin zaman geri yükleyebilirsin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmalige aankoop. Altijd te herstellen op apparaten met hetzelfde Apple-account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りの購入です。同じAppleアカウントでサインインしたデバイスでいつでも復元できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmaliger Kauf. Jederzeit auf Geräten mit demselben Apple Account wiederherstellbar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разовая покупка. Её можно восстановить на устройствах с тем же Аккаунтом Apple."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup jednorazowy. Przywrócisz go w każdej chwili na urządzeniach z tym samym kontem Apple."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time purchase. Restore it anytime on devices signed in with the same Apple Account."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto una tantum. Ripristinalo quando vuoi sui dispositivi con lo stesso Account Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性购买。可随时在登录同一 Apple 账户的设备上恢复。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat unique. Restaure-le à tout moment sur les appareils connectés au même compte Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की खरीद। उसी Apple खाते से साइन इन किए गए डिवाइस पर कभी भी रीस्टोर करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Restaure quando quiser em dispositivos com a mesma Conta Apple."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1회 구매입니다. 같은 Apple 계정으로 로그인한 기기에서 언제든 복원할 수 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần. Khôi phục bất cứ lúc nào trên thiết bị đăng nhập cùng Tài khoản Apple."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembelian satu kali. Pulihkan kapan saja di perangkat yang masuk dengan Akun Apple yang sama."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskøb. Gendan det når som helst på enheder, der er logget ind med samme Apple-konto."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียว กู้คืนได้ทุกเมื่อบนอุปกรณ์ที่ลงชื่อเข้าด้วยบัญชี Apple เดียวกัน"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Engångsköp. Återställ när som helst på enheter inloggade med samma Apple-konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única. Restáurala cuando quieras en dispositivos con la misma cuenta de Apple."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملية شراء لمرة واحدة. يمكنك استعادتها في أي وقت على الأجهزة المسجّلة بنفس حساب Apple."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性購買。可隨時在登入同一 Apple 帳號的裝置上回復。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Engangskjøp. Gjenopprett når som helst på enheter logget inn med samme Apple-konto."
          }
        }
      }
    },
