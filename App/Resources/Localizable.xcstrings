    "pro.trial.then": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi ödeme yok. %1$d gün ücretsiz, sonra yıllık %2$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu niets betalen. %1$d dagen gratis, daarna %2$@ per jaar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今はお支払い不要。%1$d日間無料、その後は年額%2$@。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt keine Zahlung. %1$d Tage gratis, danach %2$@ pro Jahr."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас без оплаты. %1$d дня бесплатно, затем %2$@ в год."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez płatności teraz. %1$d dni za darmo, potem %2$@ rocznie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No payment now. %1$d days free, then %2$@ per year."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun pagamento ora. %1$d giorni gratis, poi %2$@ all’anno."
          }
        },
