    "install.intro": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç adım. Yepyeni bir görünüm."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een paar stappen. Een nieuwe look."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少しの手順で、まったく新しいスタイルに。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenige Schritte. Ein ganz neuer Look."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всего несколько шагов. Совершенно новый образ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilka kroków. Zupełnie nowy wygląd."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few steps. A whole new look."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi passi. Un look tutto nuovo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简单几步，焕然一新。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelques étapes. Un tout nouveau style."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ कदम। एक नया लुक।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Poucos passos. Um visual novo por inteiro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "몇 단계만으로 완전히 새로운 스타일."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vài bước nhỏ. Diện mạo mới."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa langkah. Tampilan baru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få trin. Et helt nyt udtryk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่กี่ขั้นตอน สู่ลุคใหม่"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Några steg. En helt ny stil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pocos pasos. Un estilo totalmente nuevo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوات قليلة. إطلالة جديدة بالكامل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簡單幾步，煥然一新。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Noen få trinn. Et helt nytt uttrykk."
          }
        }
      }
    },
    "install.manual": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son kurulumu iOS yapar. Tamamladığın her adıma dokun; ilerlemeni hatırlayacağız."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS regelt de laatste stap. Tik op elke stap wanneer je klaar bent; we onthouden je voortgang."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の設定はiOSで行います。完了した手順をタップすると、進み具合を記録します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS übernimmt die endgültige Einrichtung. Tippe jeden Schritt an, sobald er erledigt ist. Wir merken uns deinen Fortschritt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Финальную настройку выполняет iOS. Нажимайте на каждый шаг после его завершения — мы сохраним ваш прогресс."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Końcową konfiguracją zajmuje się iOS. Stuknij każdy ukończony krok; zapamiętamy postęp."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS handles the final setup. Tap each step when you've completed it; we'll remember your progress."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS gestisce la configurazione finale. Tocca ogni passaggio dopo averlo completato; ricorderemo i tuoi progressi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后的设置由iOS完成。每完成一步就轻点标记，我们会记住你的进度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS se charge de l’installation finale. Touchez chaque étape une fois terminée ; votre progression sera conservée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम सेटअप iOS करता है। हर कदम पूरा होने पर टैप करें; आपकी प्रगति याद रखी जाएगी।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iOS cuida da configuração final. Toque em cada etapa ao concluí-la; vamos lembrar seu progresso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 설정은 iOS에서 진행합니다. 각 단계를 마친 후 눌러주세요. 진행 상황을 기억해 둘게요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS xử lý bước thiết lập cuối. Chạm từng bước khi hoàn tất; chúng tôi sẽ nhớ tiến độ của bạn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS menangani pengaturan terakhir. Ketuk tiap langkah setelah selesai; progresmu akan disimpan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS håndterer den sidste opsætning. Tryk på hvert trin, når det er udført; vi husker, hvor langt du er."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS จะจัดการการตั้งค่าขั้นสุดท้าย แตะแต่ละขั้นตอนเมื่อทำเสร็จ เราจะจำความคืบหน้าของคุณ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS hanterar den sista inställningen. Tryck på varje steg när det är klart; vi kommer ihåg dina framsteg."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS se encarga de la configuración final. Toca cada paso al completarlo; recordaremos tu progreso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتولّى iOS الإعداد النهائي. اضغط على كل خطوة عند إتمامها؛ وسنحفظ تقدّمك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最後設定由 iOS 完成。完成各步驟後請點按標記，我們會記住你的進度。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS håndterer det siste oppsettet. Trykk på hvert trinn når det er fullført; vi husker fremdriften din."
          }
        }
      }
    },
