    "export.description": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unu uyandırınca oynayan bir Live Photo olarak kaydedilir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard als Live Photo die speelt als je je iPhone wekt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneを起こすと動くLive Photoとして保存されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird als Live Photo gesichert, das beim Aufwecken deines iPhone spielt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется как Live Photo, которое оживает при пробуждении iPhone."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane jako Live Photo, które rusza po wybudzeniu iPhone’a."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved as a Live Photo that plays when you wake your iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvato come Live Photo che parte quando risvegli l’iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存为实况照片，唤醒 iPhone 时播放。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré en Live Photo qui s’anime au réveil de ton iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photo के रूप में सेव होता है, जो iPhone जगाते ही चलता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo como Live Photo que toca quando você desperta o iPhone."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone을 깨우면 재생되는 Live Photo로 저장됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu dưới dạng Live Photo phát khi bạn đánh thức iPhone."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan sebagai Live Photo yang diputar saat iPhone dibangunkan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemmes som et Live Photo, der afspilles, når du vækker din iPhone."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกเป็น Live Photo ที่เล่นเมื่อปลุก iPhone"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas som ett Live Photo som spelas när du väcker din iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda como Live Photo que se reproduce al activar tu iPhone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحفظ بصيغة Live Photo تتحرك عند إيقاظ iPhone."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存為原況照片，喚醒 iPhone 時播放。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagres som et Live Photo som spilles når du vekker iPhonen."
          }
        }
      }
    },
