        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản phát triển cục bộ · Chưa kết nối dịch vụ trực tiếp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi pengembangan lokal · Layanan langsung belum terhubung."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal udviklingsversion · Livetjenester er ikke tilsluttet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รุ่นพัฒนาในเครื่อง · ยังไม่ได้เชื่อมต่อบริการจริง"
          }
        },
        "sv": {
