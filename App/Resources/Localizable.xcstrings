    "library.emptyHint": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keşfederken bir tasarımı kaydet veya kalbe dokun. Koleksiyonun burada başlasın."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar een ontwerp of tik tijdens het ontdekken op een hartje. Daar begint je verzameling."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デザインを保存したり、気になるテーマのハートをタップしたり。ここからコレクションが始まります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere einen Entwurf oder tippe beim Entdecken auf ein Herz. Hier beginnt deine Sammlung."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните дизайн или нажмите на сердечко при просмотре. С этого начинается ваша коллекция."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz projekt lub stuknij serce podczas odkrywania. Tak zaczyna się Twoja kolekcja."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a design or tap a heart while exploring. Your collection starts there."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un design o tocca un cuore mentre esplori. La tua collezione inizia qui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存一个设计，或在探索时轻点爱心。你的收藏就从这里开始。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un design ou touchez un cœur pendant votre exploration. Votre collection commence ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिज़ाइन सहेजें या खोजते समय दिल पर टैप करें। आपका संग्रह यहीं से शुरू होता है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve um design ou toque no coração enquanto explora. Sua coleção começa aí."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디자인을 저장하거나 둘러보면서 하트를 눌러보세요. 나만의 컬렉션이 시작됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu thiết kế hoặc chạm trái tim khi khám phá. Bộ sưu tập bắt đầu từ đó."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan desain atau ketuk hati saat menjelajah. Mulai koleksimu dari sana."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gem et design, eller tryk på et hjerte, mens du udforsker. Din samling begynder der."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกดีไซน์หรือแตะหัวใจระหว่างสำรวจ เพื่อเริ่มคอลเลกชั่นของคุณ"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spara en design eller tryck på ett hjärta när du utforskar. Din samling börjar där."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda un diseño o toca un corazón mientras exploras. Tu colección empieza ahí."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تصميمًا أو اضغط على القلب أثناء الاستكشاف. من هنا تبدأ مجموعتك."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存設計，或在探索時點按愛心，開始你的收藏。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagre et design eller trykk på et hjerte mens du utforsker. Samlingen din begynner der."
          }
        }
      }
    },
