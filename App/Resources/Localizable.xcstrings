        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "애니메이션을 만들 수 없습니다. 다시 시도해 주세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể tạo hoạt ảnh. Vui lòng thử lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Animasi tidak dapat dibuat. Coba lagi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Animationen kunne ikke oprettes. Prøv igen."
