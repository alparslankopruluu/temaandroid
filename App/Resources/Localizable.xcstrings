    },
    "export.error.cancelled": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarma iptal edildi. Açtığın kullanım hakkı hâlâ geçerli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Export geannuleerd. Je ontgrendeling blijft beschikbaar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出しをキャンセルしました。獲得した書き出し権はそのまま利用できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Export abgebrochen. Deine Freischaltung bleibt verfügbar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспорт отменён. Полученное право на экспорт сохранено."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport anulowany. Odblokowany eksport pozostaje dostępny."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export cancelled. Your unlock is still available."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esportazione annullata. Lo sblocco è ancora disponibile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出已取消，你解锁的导出次数仍然可用。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportation annulée. Votre déblocage reste disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट रद्द हुआ। आपका अनलॉक अभी भी उपलब्ध है।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportação cancelada. O desbloqueio continua disponível."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기를 취소했습니다. 잠금 해제한 내보내기 권한은 그대로 사용할 수 있습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy xuất. Lượt mở khóa của bạn vẫn còn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekspor dibatalkan. Hak ekspormu masih tersedia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport annulleret. Din oplåsning er stadig tilgængelig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการส่งออกแล้ว สิทธิ์ที่ปลดล็อคไว้ยังใช้ได้"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporten avbröts. Din upplåsning finns kvar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportación cancelada. Tu desbloqueo sigue disponible."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء التصدير. لا يزال حق التصدير الذي فتحته متاحًا."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消匯出，你的解鎖次數仍可使用。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksport avbrutt. Opplåsingen din er fortsatt tilgjengelig."
          }
        }
      }
    },
    "platform.short": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada etkileşimli. Kilit ekranın için Live Photo olarak kaydet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier interactief. Bewaar als Live Photo voor je toegangsscherm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ内で操作できます。ロック画面用にLive Photoとして保存。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier interaktiv. Als Live Photo für den Sperrbildschirm sichern."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь — интерактивно. Сохраните как Live Photo для экрана блокировки."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu interaktywne. Zapisz jako Live Photo na ekran blokady."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive here. Save it as a Live Photo for your Lock Screen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interattivo qui. Salvalo come Live Photo per la schermata di blocco."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此可互动。存为实况照片用于锁定屏幕。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactif ici. Enregistre-le en Live Photo pour ton écran verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इंटरैक्टिव। लॉक स्क्रीन के लिए Live Photo के रूप में सेव करें।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interativo aqui. Salve como Live Photo para a Tela Bloqueada."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 인터랙티브. 잠금 화면용 Live Photo로 저장하세요."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tương tác tại đây. Lưu thành Live Photo cho Màn hình khóa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktif di sini. Simpan sebagai Live Photo untuk Layar Kunci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktiv her. Gem den som Live Photo til låseskærmen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โต้ตอบได้ที่นี่ บันทึกเป็น Live Photo สำหรับหน้าจอล็อก"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktiv här. Spara som Live Photo för låsskärmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactivo aquí. Guárdalo como Live Photo para tu pantalla de bloqueo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفاعلي هنا. احفظه بصيغة Live Photo لشاشة القفل."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此可互動。儲存為原況照片用於鎖定畫面。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaktiv her. Lagre den som Live Photo for låseskjermen."
          }
        }
      }
    },
    "platform.detail": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokunma ve eğme etkileşimleri ScreenMotion içinde çalışır. Live Photo, kilit ekranını uyandırdığında hareket edebilir. Hangi görsellerin Live Photo duvar kâğıdını veya Uzamsal Sahne’yi desteklediğine iOS karar verir. Duvar kâğıdını Ayarlar’dan kendin uygula; ana ekran duvar kâğıtları sabit kalır."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanraken en kantelen werken binnen ScreenMotion. Live Photos kunnen bewegen wanneer je het toegangsscherm activeert. iOS bepaalt welke beelden Live Photo-achtergronden of ruimtelijke scènes ondersteunen. Stel je achtergrond handmatig in via Instellingen; achtergronden op het beginscherm blijven stilstaan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タッチや傾きの操作はScreenMotion内で動作します。Live Photoはロック画面をスリープ解除した際に動く場合があります。Live Photoの壁紙や空間シーンに対応する画像はiOSが判断します。設定から手動で壁紙を設定してください。ホーム画面の壁紙は静止画です。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berührungs- und Neigungseffekte funktionieren innerhalb von ScreenMotion. Live Photos können beim Aktivieren des Sperrbildschirms animiert werden. iOS entscheidet, welche Bilder Live-Photo-Hintergründe oder räumliche Szenen unterstützen. Richte dein Hintergrundbild selbst in den Einstellungen ein; auf dem Home-Bildschirm bleibt es statisch."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реакция на касания и наклоны работает внутри ScreenMotion. Live Photo может анимироваться при пробуждении экрана блокировки. iOS определяет, какие изображения поддерживают обои Live Photo или пространственную сцену. Установите обои вручную в настройках; на экране «Домой» они остаются неподвижными."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotyk i przechylanie działają w ScreenMotion. Live Photo może się poruszać przy wybudzeniu ekranu blokady. iOS decyduje, które obrazy obsługują tapetę Live Photo lub scenę przestrzenną. Ustaw tapetę ręcznie w Ustawieniach; tapety ekranu początkowego są nieruchome."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and tilt interactions work inside ScreenMotion. Live Photos can animate when you wake your Lock Screen. iOS decides which images support Live Photo wallpaper or Spatial Scene. Set your wallpaper manually in Settings; Home Screen wallpapers stay still."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le interazioni con tocco e inclinazione funzionano dentro ScreenMotion. Le Live Photo possono animarsi quando riattivi la schermata di blocco. iOS decide quali immagini supportano gli sfondi Live Photo o le scene spaziali. Imposta lo sfondo manualmente in Impostazioni; gli sfondi della schermata Home restano fissi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触摸和倾斜交互仅在ScreenMotion内生效。唤醒锁定屏幕时，实况照片可能会播放动画。是否支持实况照片壁纸或空间场景由iOS根据图片决定。请前往设置手动设置壁纸；主屏幕壁纸保持静态。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les interactions tactiles et par inclinaison fonctionnent dans ScreenMotion. Les Live Photos peuvent s’animer au réveil de l’écran verrouillé. iOS détermine quelles images sont compatibles avec les fonds Live Photo ou les scènes spatiales. Définissez votre fond d’écran dans Réglages ; celui de l’écran d’accueil reste fixe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छूने और झुकाने की क्रियाएँ ScreenMotion के अंदर काम करती हैं। लॉक स्क्रीन जगाने पर Live Photo चल सकती है। कौन-सी तस्वीर Live Photo वॉलपेपर या स्थानिक दृश्य का समर्थन करती है, यह iOS तय करता है। सेटिंग्ज़ में वॉलपेपर खुद सेट करें; होम स्क्रीन के वॉलपेपर स्थिर रहते हैं।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As interações por toque e inclinação funcionam dentro do ScreenMotion. Live Photos podem se animar ao despertar a Tela Bloqueada. O iOS determina quais imagens aceitam papel de parede com Live Photo ou Cena Espacial. Defina o papel de parede manualmente em Ajustes; na Tela de Início, ele permanece estático."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터치와 기울기 반응은 ScreenMotion 안에서 작동합니다. Live Photo는 잠금 화면을 깨울 때 움직일 수 있습니다. Live Photo 배경화면이나 공간 장면을 지원하는 이미지는 iOS가 결정합니다. 설정에서 직접 배경화면을 지정해 주세요. 홈 화면 배경은 정지 이미지로 표시됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tương tác chạm và nghiêng chỉ hoạt động trong ScreenMotion. Live Photo có thể chuyển động khi đánh thức Màn hình khóa. iOS quyết định ảnh nào hỗ trợ hình nền Live Photo hoặc Cảnh không gian. Đặt hình nền thủ công trong Cài đặt; hình nền Màn hình chính luôn tĩnh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Interaksi sentuh dan kemiringan berfungsi di dalam ScreenMotion. Live Photo dapat bergerak saat Layar Kunci dibangunkan. iOS menentukan gambar yang mendukung wallpaper Live Photo atau Adegan Spasial. Atur wallpaper secara manual di Pengaturan; wallpaper Layar Utama tetap diam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Berøring og vipning virker inde i ScreenMotion. Live Photos kan animeres, når låseskærmen vækkes. iOS afgør, hvilke billeder der understøtter Live Photo-baggrund eller rumlig scene. Indstil baggrunden manuelt i Indstillinger; hjemmeskærmens baggrund er statisk."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแตะและเอียงทำงานภายใน ScreenMotion เท่านั้น Live Photo อาจเคลื่อนไหวเมื่อปลุกหน้าจอล็อค โดย iOS จะกำหนดว่าภาพใดรองรับภาพพื้นหลัง Live Photo หรือฉากเชิงมิติ ตั้งค่าภาพพื้นหลังด้วยตนเองในการตั้งค่า ภาพพื้นหลังหน้าจอโฮมจะเป็นภาพนิ่ง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beröring och lutning fungerar i ScreenMotion. Live Photos kan animeras när du väcker låsskärmen. iOS avgör vilka bilder som stöder Live Photo-bakgrund eller rumslig scen. Ställ in bakgrunden manuellt i Inställningar; hemskärmens bakgrunder är stilla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las interacciones táctiles y de inclinación funcionan dentro de ScreenMotion. Las Live Photos pueden animarse al activar la pantalla de bloqueo. iOS decide qué imágenes admiten fondos Live Photo o escenas espaciales. Configura el fondo manualmente en Ajustes; los fondos de la pantalla de inicio son estáticos."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل التفاعل باللمس والإمالة داخل ScreenMotion. يمكن أن تتحرّك صور Live Photo عند إيقاظ شاشة القفل. يحدّد iOS الصور التي تدعم خلفيات Live Photo أو المشاهد المكانية. عيّن خلفيتك يدويًا من الإعدادات؛ وتبقى خلفية الشاشة الرئيسية ثابتة."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸控與傾斜互動僅適用於 ScreenMotion 內。喚醒鎖定畫面時，原況照片可播放動畫。是否支援原況照片背景圖片或空間場景由 iOS 決定。請在「設定」中手動設定背景圖片；主畫面背景圖片為靜態。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Berøring og vipping virker inne i ScreenMotion. Live Photos kan animeres når låst skjerm vekkes. iOS avgjør hvilke bilder som støtter Live Photo-bakgrunn eller romlig scene. Angi bakgrunn manuelt i Innstillinger; bakgrunnen på Hjem-skjermen er statisk."
          }
        }
      }
    },
    "pro.title": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sahne. Her döngü."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke scène. Elke loop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのシーン。すべてのループ。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Szene. Jeder Loop."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая сцена. Каждый цикл."
          }
        },
        "pl": {
          "stringUnit": {
