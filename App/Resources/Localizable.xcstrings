    "pro.testNotice": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel test sürümü. Satın almalar Xcode StoreKit testiyle yapılır. Gerçek ücret alınmaz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale testversie. Aankopen gebruiken Xcode StoreKit-tests. Er wordt geen echt geld afgeschreven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルテスト版です。購入にはXcodeのStoreKitテストを使用します。実際の料金は請求されません。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Testversion. Käufe laufen über Xcode StoreKit-Tests. Es wird kein echtes Geld abgebucht."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальная тестовая сборка. Покупки выполняются через тестирование StoreKit в Xcode. Реальные деньги не списываются."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalna wersja testowa. Zakupy korzystają z testów Xcode StoreKit. Nie pobieramy prawdziwych płatności."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local test build. Purchases use Xcode StoreKit testing. No real payment is taken."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Versione di test locale. Gli acquisti usano i test StoreKit di Xcode. Non viene addebitato alcun pagamento reale."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地测试版本。购买通过Xcode StoreKit测试进行，不会产生真实扣款。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Version de test locale. Les achats utilisent les tests StoreKit de Xcode. Aucun paiement réel n’est prélevé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय परीक्षण संस्करण। खरीदारी Xcode StoreKit परीक्षण से होती है। असली भुगतान नहीं लिया जाता।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versão de teste local. As compras usam testes do StoreKit no Xcode. Nenhum pagamento real é cobrado."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 테스트 버전입니다. 구매는 Xcode StoreKit 테스트를 사용하며 실제 요금은 청구되지 않습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản thử nghiệm cục bộ. Giao dịch dùng kiểm thử Xcode StoreKit. Không thu tiền thật."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi uji lokal. Pembelian memakai pengujian Xcode StoreKit. Tidak ada pembayaran nyata."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal testversion. Køb bruger Xcode StoreKit-test. Der opkræves ingen rigtige penge."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รุ่นทดสอบในเครื่อง การซื้อใช้การทดสอบ Xcode StoreKit ไม่มีการเรียกเก็บเงินจริง"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal testversion. Köp använder Xcode StoreKit-testning. Ingen riktig betalning görs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versión de prueba local. Las compras usan las pruebas de StoreKit de Xcode. No se realiza ningún cobro real."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة اختبار محلية. تستخدم المشتريات اختبارات Xcode StoreKit. لن يتم تحصيل أي مبلغ حقيقي."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機測試版本。購買使用 Xcode StoreKit 測試，不會實際扣款。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokal testversjon. Kjøp bruker Xcode StoreKit-testing. Ingen ekte betaling belastes."
          }
        }
      }
    },
    "pro.terms": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik, App Store ayarlarından iptal edilene kadar seçilen dönem için otomatik yenilenir."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het abonnement wordt automatisch verlengd voor de gekozen periode totdat je het opzegt in de App Store-instellingen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サブスクリプションは、App Storeの設定で解約するまで、選択した期間ごとに自動更新されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo verlängert sich automatisch um den gewählten Zeitraum, bis es in den App-Store-Einstellungen gekündigt wird."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка автоматически продлевается на выбранный период, пока вы не отмените её в настройках App Store."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja odnawia się automatycznie na wybrany okres, dopóki nie anulujesz jej w ustawieniach App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscription renews automatically for the selected period until canceled in App Store settings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abbonamento si rinnova automaticamente per il periodo scelto finché non viene annullato nelle impostazioni dell’App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅将按所选周期自动续订，直至你在App Store设置中取消。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement se renouvelle automatiquement pour la période choisie jusqu’à sa résiliation dans les réglages de l’App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सदस्यता चुनी हुई अवधि के लिए अपने आप नवीनीकृत होती है, जब तक कि App Store सेटिंग्ज़ में रद्द न की जाए।"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura é renovada automaticamente pelo período escolhido até ser cancelada nos ajustes da App Store."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독은 App Store 설정에서 취소할 때까지 선택한 기간마다 자동 갱신됩니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký tự động gia hạn theo kỳ đã chọn cho đến khi bạn hủy trong cài đặt App Store."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Langganan diperpanjang otomatis sesuai periode yang dipilih hingga dibatalkan di pengaturan App Store."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet fornyes automatisk for den valgte periode, indtil det opsiges i App Store-indstillinger."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสมัครสมาชิกจะต่ออายุอัตโนมัติตามระยะเวลาที่เลือกจนกว่าจะยกเลิกในการตั้งค่า App Store"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationen förnyas automatiskt för vald period tills den sägs upp i App Store-inställningarna."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La suscripción se renueva automáticamente por el periodo seleccionado hasta que la canceles en los ajustes del App Store."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجدّد الاشتراك تلقائيًا للفترة المحددة حتى يتم إلغاؤه من إعدادات App Store."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "訂閱會按所選期間自動續訂，直到你在App Store設定中取消。"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet fornyes automatisk for valgt periode til det sies opp i App Store-innstillingene."
          }
        }
