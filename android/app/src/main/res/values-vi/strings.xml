    <string name="install_title" formatted="false">Thiết lập</string>
    <string name="install_wallpaper" formatted="false">Đặt hình nền</string>
    <string name="install_wallpaper_1" formatted="false">Mở Cài đặt → Hình nền → Thêm hình nền mới. Chọn Ảnh rồi chọn ảnh bạn đã lưu.</string>
    <string name="install_wallpaper_2" formatted="false">Với Live Photo, bật chuyển động nếu iOS có tùy chọn này. Thử Cảnh không gian với ảnh đủ điều kiện. Điều chỉnh khung cắt và đồng hồ trong trình sửa của hệ thống.</string>
    <string name="install_wallpaper_3" formatted="false">Chạm Thêm, rồi chọn Đặt làm cặp hình nền hoặc tùy chỉnh Màn hình chính. Đánh thức điện thoại để kiểm tra kết quả.</string>
    <string name="install_widgets" formatted="false">Thêm tiện ích</string>
    <string name="install_widgets_1" formatted="false">Chọn nền tiện ích trong ScreenMotion. Trên Màn hình chính, chạm và giữ một vùng trống.</string>
    <string name="install_widgets_2" formatted="false">Chạm Sửa → Thêm tiện ích, tìm ScreenMotion, chọn kích thước rồi chạm Thêm tiện ích. Với iOS cũ, dùng nút +.</string>
    <string name="install_widgets_3" formatted="false">Chạm và giữ tiện ích → Sửa tiện ích để chọn Ảnh, Đồng hồ và ngày, Lịch hoặc Bộ sưu tập. Thêm tiện ích Màn hình khóa trong trình sửa Màn hình khóa của hệ thống.</string>
