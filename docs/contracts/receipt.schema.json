{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-factory.local/contracts/completion-receipt-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractType", "taskId", "resultSummary", "changedPaths", "acceptance", "validations", "decisions", "assumptions", "unresolvedRisks", "exactNextAction", "source"],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [2]},
    "contractType": {"type": "string", "enum": ["completion_receipt"]},
    "receiptId": {"type": "string", "minLength": 1},
    "submittedAt": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "resultSummary": {"type": "string", "minLength": 1},
    "changedPaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "evidenceIds"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["pass", "skip"]}, "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}}, "note": {"type": "string", "minLength": 1}}}},
    "validations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "status", "evidenceIds"], "properties": {"id": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["pass"]}, "evidenceIds": {"type": "array", "items": {"type": "string", "minLength": 1}}}}},
    "decisions": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "unresolvedRisks": {"type": "array", "items": {"type": "string"}},
    "exactNextAction": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["revision", "workingTreeDigest", "capsuleId", "packetDigest"], "properties": {"revision": {"type": "string", "minLength": 1}, "workingTreeDigest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}, "capsuleId": {"type": "string", "minLength": 1}, "packetDigest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}}},
    "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "path", "sha256", "size", "sourceRevision"], "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}, "size": {"type": "integer"}, "sourceRevision": {"type": "string", "minLength": 1}}}},
    "workflow": {"type": "object", "additionalProperties": false, "required": ["planDigest", "adapter", "actualAgentCount", "resultDigests", "rejectedFindings", "synthesis"], "properties": {"planDigest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}, "adapter": {"type": "string", "enum": ["claude", "codex", "grok", "cli"]}, "actualAgentCount": {"type": "integer"}, "resultDigests": {"type": "array", "items": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}}, "rejectedFindings": {"type": "array", "items": {"type": "string"}}, "synthesis": {"type": "string", "minLength": 1}}}
  }
}
