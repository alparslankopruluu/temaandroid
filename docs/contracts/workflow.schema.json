{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-factory.local/contracts/workflow-plan-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractType", "workflowId", "objective", "source", "adapter", "modelClass", "worktreePolicy", "limits", "tasks", "stopConditions", "validators", "expectedOutput", "approvalRequirements"],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [1]},
    "contractType": {"type": "string", "enum": ["workflow_plan"]},
    "workflowId": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "workingTreeDigest"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "workingTreeDigest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}
      }
    },
    "adapter": {"type": "string", "enum": ["auto", "claude", "codex", "grok", "cli"]},
    "modelClass": {"type": "string", "enum": ["frontier_high", "bounded_implementation", "mechanical", "mixed"]},
    "worktreePolicy": {"type": "string", "enum": ["read_only", "single_writer", "isolated_writers"]},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentAgents", "maxTotalAgents", "spendCeiling"],
      "properties": {
        "maxConcurrentAgents": {"type": "integer"},
        "maxTotalAgents": {"type": "integer"},
        "spendCeiling": {"type": ["number", "null"]}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "objective", "dependsOn", "allowedPaths", "forbiddenPaths", "acceptance", "validations"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "objective": {"type": "string", "minLength": 1},
          "dependsOn": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "allowedPaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "forbiddenPaths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "validations": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "stopConditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "validators": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expectedOutput": {"type": "string", "minLength": 1},
    "approvalRequirements": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
